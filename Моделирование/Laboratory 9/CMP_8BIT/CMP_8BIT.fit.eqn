--C1L1 is CMP_2bit:inst2|inst17~18 at LC_X52_Y28_N5
--operation mode is normal

C1L1 = Y7 & X7 & (X6 # !Y6) # !Y7 & (X6 # X7 # !Y6);


--C1L5 is CMP_2bit:inst2|inst28~399 at LC_X52_Y26_N4
--operation mode is normal

C1L5 = X4 & Y4 & (X5 $ !Y5) # !X4 & !Y4 & (X5 $ !Y5);


--C1L71 is CMP_2bit:inst2|inst35~32 at LC_X52_Y28_N9
--operation mode is normal

C1L71 = C1L5 & (Y3 $ !X3);


--C1L6 is CMP_2bit:inst2|inst28~400 at LC_X52_Y24_N2
--operation mode is normal

C1L6 = X2 & Y1 & Y2 & !X1 # !X2 & (Y2 # Y1 & !X1);


--C1L81 is CMP_2bit:inst2|inst35~33 at LC_X52_Y24_N4
--operation mode is normal

C1L81 = X2 & Y2 & (Y1 $ !X1) # !X2 & !Y2 & (Y1 $ !X1);


--C1L7 is CMP_2bit:inst2|inst28~401 at LC_X52_Y29_N2
--operation mode is normal

C1L7 = !X0 & (Y0);


--C1L8 is CMP_2bit:inst2|inst28~402 at LC_X52_Y28_N6
--operation mode is normal

C1L8 = C1L71 & (C1L6 # C1L81 & C1L7);


--C1L9 is CMP_2bit:inst2|inst28~403 at LC_X52_Y26_N5
--operation mode is normal

C1L9 = X5 & !X4 & Y4 & Y5 # !X5 & (Y5 # !X4 & Y4);


--C1L01 is CMP_2bit:inst2|inst28~404 at LC_X52_Y28_N8
--operation mode is normal

C1L01 = C1L9 # Y3 & C1L5 & !X3;


--C1L91 is CMP_2bit:inst2|inst35~34 at LC_X52_Y28_N1
--operation mode is normal

C1L91 = X6 & Y6 & (Y7 $ !X7) # !X6 & !Y6 & (Y7 $ !X7);


--C1L2 is CMP_2bit:inst2|inst17~19 at LC_X52_Y28_N4
--operation mode is normal

C1L2 = C1L1 & (!C1L01 & !C1L8 # !C1L91);


--C1L3 is CMP_2bit:inst2|inst19~18 at LC_X52_Y27_N2
--operation mode is normal

C1L3 = Y7 & (Y6 # !X7 # !X6) # !Y7 & !X7 & (Y6 # !X6);


--C1L11 is CMP_2bit:inst2|inst33~397 at LC_X52_Y24_N5
--operation mode is normal

C1L11 = X2 & (!Y1 & X1 # !Y2) # !X2 & !Y1 & !Y2 & X1;


--C1L21 is CMP_2bit:inst2|inst33~398 at LC_X52_Y29_N5
--operation mode is normal

C1L21 = X0 & (!Y0);


--C1L31 is CMP_2bit:inst2|inst33~399 at LC_X52_Y28_N0
--operation mode is normal

C1L31 = C1L71 & (C1L11 # C1L81 & C1L21);


--C1L41 is CMP_2bit:inst2|inst33~400 at LC_X52_Y26_N2
--operation mode is normal

C1L41 = X5 & (X4 & !Y4 # !Y5) # !X5 & X4 & !Y4 & !Y5;


--C1L51 is CMP_2bit:inst2|inst33~401 at LC_X52_Y28_N3
--operation mode is normal

C1L51 = C1L41 # !Y3 & X3 & C1L5;


--C1L4 is CMP_2bit:inst2|inst19~19 at LC_X52_Y28_N2
--operation mode is normal

C1L4 = C1L3 & (!C1L51 & !C1L31 # !C1L91);


--C3_inst30 is CMP_6BIT:inst|CMP_4bit:inst1|CMP_2bit:inst|inst30 at LC_X52_Y29_N4
--operation mode is normal

C3_inst30 = X0 $ (Y0);


--C1_inst35 is CMP_2bit:inst2|inst35 at LC_X52_Y28_N7
--operation mode is normal

C1_inst35 = C1L81 & C1L71 & C1L91 & !C3_inst30;


--X7 is X7 at PIN_F5
--operation mode is input

X7 = INPUT();


--X6 is X6 at PIN_G3
--operation mode is input

X6 = INPUT();


--Y6 is Y6 at PIN_G5
--operation mode is input

Y6 = INPUT();


--Y7 is Y7 at PIN_E2
--operation mode is input

Y7 = INPUT();


--Y5 is Y5 at PIN_J6
--operation mode is input

Y5 = INPUT();


--Y4 is Y4 at PIN_J4
--operation mode is input

Y4 = INPUT();


--X4 is X4 at PIN_G4
--operation mode is input

X4 = INPUT();


--X5 is X5 at PIN_K6
--operation mode is input

X5 = INPUT();


--X3 is X3 at PIN_B2
--operation mode is input

X3 = INPUT();


--Y3 is Y3 at PIN_F3
--operation mode is input

Y3 = INPUT();


--Y2 is Y2 at PIN_F1
--operation mode is input

Y2 = INPUT();


--Y1 is Y1 at PIN_F2
--operation mode is input

Y1 = INPUT();


--X1 is X1 at PIN_H3
--operation mode is input

X1 = INPUT();


--X2 is X2 at PIN_H4
--operation mode is input

X2 = INPUT();


--Y0 is Y0 at PIN_D1
--operation mode is input

Y0 = INPUT();


--X0 is X0 at PIN_F4
--operation mode is input

X0 = INPUT();


--XLY is XLY at PIN_E1
--operation mode is output

XLY = OUTPUT(!C1L2);


--XMY is XMY at PIN_B3
--operation mode is output

XMY = OUTPUT(!C1L4);


--XEY is XEY at PIN_D2
--operation mode is output

XEY = OUTPUT(C1_inst35);



