--B2L1 is CMP_2bit:inst1|inst17~18
--operation mode is normal

B2L1 = X3 & (X2 # !Y3 # !Y2) # !X3 & !Y3 & (X2 # !Y2);


--B2L5 is CMP_2bit:inst1|inst28~99
--operation mode is normal

B2L5 = Y1 & (Y0 & !X0 # !X1) # !Y1 & Y0 & !X0 & !X1;


--B2L8 is CMP_2bit:inst1|inst35~52
--operation mode is normal

B2L8 = Y3 & X3 & (X2 $ !Y2) # !Y3 & !X3 & (X2 $ !Y2);


--B2L2 is CMP_2bit:inst1|inst17~19
--operation mode is normal

B2L2 = B2L1 & (!B2L8 # !B2L5);


--B2L3 is CMP_2bit:inst1|inst19~18
--operation mode is normal

B2L3 = Y3 & (Y2 # !X3 # !X2) # !Y3 & !X3 & (Y2 # !X2);


--B2L6 is CMP_2bit:inst1|inst33~104
--operation mode is normal

B2L6 = X1 & (X0 & !Y0 # !Y1) # !X1 & X0 & !Y0 & !Y1;


--B2L4 is CMP_2bit:inst1|inst19~19
--operation mode is normal

B2L4 = B2L3 & (!B2L6 # !B2L8);


--B1_inst22 is CMP_2bit:inst|inst22
--operation mode is normal

B1_inst22 = Y1 $ X1;


--B2_inst35 is CMP_2bit:inst1|inst35
--operation mode is normal

B2_inst35 = B2L8 & !B1_inst22 & (X0 $ !Y0);


--X3 is X3
--operation mode is input

X3 = INPUT();


--X2 is X2
--operation mode is input

X2 = INPUT();


--Y2 is Y2
--operation mode is input

Y2 = INPUT();


--Y3 is Y3
--operation mode is input

Y3 = INPUT();


--Y1 is Y1
--operation mode is input

Y1 = INPUT();


--Y0 is Y0
--operation mode is input

Y0 = INPUT();


--X0 is X0
--operation mode is input

X0 = INPUT();


--X1 is X1
--operation mode is input

X1 = INPUT();


--XLY is XLY
--operation mode is output

XLY = OUTPUT(!B2L2);


--XMY is XMY
--operation mode is output

XMY = OUTPUT(!B2L4);


--XEY is XEY
--operation mode is output

XEY = OUTPUT(B2_inst35);


