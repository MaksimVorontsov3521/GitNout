--B2L1 is CMP_2bit:inst1|inst17~18 at LC_X1_Y1_N9
--operation mode is normal

B2L1 = Y3 & X3 & (X2 # !Y2) # !Y3 & (X2 # X3 # !Y2);


--B2L5 is CMP_2bit:inst1|inst28~99 at LC_X1_Y1_N2
--operation mode is normal

B2L5 = X1 & !X0 & Y0 & Y1 # !X1 & (Y1 # !X0 & Y0);


--B2L8 is CMP_2bit:inst1|inst35~52 at LC_X1_Y1_N4
--operation mode is normal

B2L8 = Y2 & X2 & (Y3 $ !X3) # !Y2 & !X2 & (Y3 $ !X3);


--B2L2 is CMP_2bit:inst1|inst17~19 at LC_X1_Y1_N3
--operation mode is normal

B2L2 = B2L1 & (!B2L8 # !B2L5);


--B2L3 is CMP_2bit:inst1|inst19~18 at LC_X1_Y1_N8
--operation mode is normal

B2L3 = Y3 & (Y2 # !X3 # !X2) # !Y3 & !X3 & (Y2 # !X2);


--B2L6 is CMP_2bit:inst1|inst33~104 at LC_X1_Y1_N1
--operation mode is normal

B2L6 = X1 & (X0 & !Y0 # !Y1) # !X1 & X0 & !Y0 & !Y1;


--B2L4 is CMP_2bit:inst1|inst19~19 at LC_X1_Y1_N5
--operation mode is normal

B2L4 = B2L3 & (!B2L6 # !B2L8);


--B1_inst22 is CMP_2bit:inst|inst22 at LC_X1_Y1_N6
--operation mode is normal

B1_inst22 = X1 $ Y1;


--B2_inst35 is CMP_2bit:inst1|inst35 at LC_X1_Y1_N7
--operation mode is normal

B2_inst35 = B2L8 & !B1_inst22 & (X0 $ !Y0);


--X3 is X3 at PIN_Y21
--operation mode is input

X3 = INPUT();


--X2 is X2 at PIN_U19
--operation mode is input

X2 = INPUT();


--Y2 is Y2 at PIN_U20
--operation mode is input

Y2 = INPUT();


--Y3 is Y3 at PIN_AA21
--operation mode is input

Y3 = INPUT();


--Y1 is Y1 at PIN_Y20
--operation mode is input

Y1 = INPUT();


--Y0 is Y0 at PIN_W19
--operation mode is input

Y0 = INPUT();


--X0 is X0 at PIN_T18
--operation mode is input

X0 = INPUT();


--X1 is X1 at PIN_W20
--operation mode is input

X1 = INPUT();


--XLY is XLY at PIN_W22
--operation mode is output

XLY = OUTPUT(!B2L2);


--XMY is XMY at PIN_AA20
--operation mode is output

XMY = OUTPUT(!B2L4);


--XEY is XEY at PIN_W21
--operation mode is output

XEY = OUTPUT(B2_inst35);



