--A1L7 is XEY~53 at LC_X5_Y1_N6
--operation mode is normal

A1L7 = Y[1] & (Y[0] # !X[1] # !X[0]) # !Y[1] & !X[1] & (Y[0] # !X[0]);


--A1L41 is XMY~25 at LC_X5_Y1_N2
--operation mode is normal

A1L41 = XMI0 # !A1L7;


--A1L1 is LessThan~131 at LC_X5_Y1_N8
--operation mode is normal

A1L1 = Y[1] & (!X[0] & Y[0] # !X[1]) # !Y[1] & !X[0] & Y[0] & !X[1];


--A1L11 is XLY~41 at LC_X5_Y1_N5
--operation mode is normal

A1L11 = XLI0 # A1L7 & A1L1;


--A1L8 is XEY~54 at LC_X5_Y1_N4
--operation mode is normal

A1L8 = XEI0 & A1L7 & (!A1L1);


--XMI0 is XMI0 at PIN_V18
--operation mode is input

XMI0 = INPUT();


--Y[1] is Y[1] at PIN_AB17
--operation mode is input

Y[1] = INPUT();


--Y[0] is Y[0] at PIN_Y18
--operation mode is input

Y[0] = INPUT();


--X[0] is X[0] at PIN_AA19
--operation mode is input

X[0] = INPUT();


--X[1] is X[1] at PIN_Y17
--operation mode is input

X[1] = INPUT();


--XLI0 is XLI0 at PIN_AB18
--operation mode is input

XLI0 = INPUT();


--XEI0 is XEI0 at PIN_Y16
--operation mode is input

XEI0 = INPUT();


--XMY is XMY at PIN_AB19
--operation mode is output

XMY = OUTPUT(A1L41);


--XLY is XLY at PIN_W17
--operation mode is output

XLY = OUTPUT(A1L11);


--XEY is XEY at PIN_V17
--operation mode is output

XEY = OUTPUT(A1L8);



