--A1L1 is inst17~131 at LC_X5_Y1_N9
--operation mode is normal

A1L1 = Y1 & X1 & (X0 # !Y0) # !Y1 & (X0 # X1 # !Y0);


--A1L5 is inst28~34 at LC_X5_Y1_N6
--operation mode is normal

A1L5 = Y1 & X1 & (Y0 $ !X0) # !Y1 & !X1 & (Y0 $ !X0);


--A1L2 is inst17~132 at LC_X5_Y1_N2
--operation mode is normal

A1L2 = A1L1 & (!A1L5 # !XLY0);


--inst35 is inst35 at LC_X5_Y1_N5
--operation mode is normal

inst35 = XEY0 & A1L5;


--A1L3 is inst19~131 at LC_X5_Y1_N8
--operation mode is normal

A1L3 = Y1 & (Y0 # !X1 # !X0) # !Y1 & !X1 & (Y0 # !X0);


--A1L4 is inst19~132 at LC_X5_Y1_N4
--operation mode is normal

A1L4 = A1L3 & (!A1L5 # !XMY0);


--X1 is X1 at PIN_V18
--operation mode is input

X1 = INPUT();


--X0 is X0 at PIN_AB17
--operation mode is input

X0 = INPUT();


--Y0 is Y0 at PIN_Y18
--operation mode is input

Y0 = INPUT();


--Y1 is Y1 at PIN_AA19
--operation mode is input

Y1 = INPUT();


--XLY0 is XLY0 at PIN_Y17
--operation mode is input

XLY0 = INPUT();


--XEY0 is XEY0 at PIN_AB18
--operation mode is input

XEY0 = INPUT();


--XMY0 is XMY0 at PIN_Y16
--operation mode is input

XMY0 = INPUT();


--XLY is XLY at PIN_AB19
--operation mode is output

XLY = OUTPUT(!A1L2);


--XEY is XEY at PIN_W17
--operation mode is output

XEY = OUTPUT(inst35);


--XMY is XMY at PIN_V17
--operation mode is output

XMY = OUTPUT(!A1L4);



