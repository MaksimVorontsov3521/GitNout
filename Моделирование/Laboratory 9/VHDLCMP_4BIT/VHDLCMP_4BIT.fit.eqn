--B2L3 is VHDLCMP_2BIT:U2|XMY~56 at LC_X1_Y30_N5
--operation mode is normal

B2L3 = Y[3] & !Y[2] & X[2] & X[3] # !Y[3] & (X[3] # !Y[2] & X[2]);


--B2L2 is VHDLCMP_2BIT:U2|XLY~63 at LC_X1_Y30_N0
--operation mode is normal

B2L2 = Y[3] & (Y[2] & !X[2] # !X[3]) # !Y[3] & Y[2] & !X[2] & !X[3];


--B2L1 is VHDLCMP_2BIT:U2|XEY~9 at LC_X1_Y30_N4
--operation mode is normal

B2L1 = Y[3] & (Y[2] $ X[2] # !X[3]) # !Y[3] & (X[3] # Y[2] $ X[2]);


--X[0] is X[0] at PIN_B21
--operation mode is input

X[0] = INPUT();


--X[1] is X[1] at PIN_K15
--operation mode is input

X[1] = INPUT();


--Y[0] is Y[0] at PIN_T19
--operation mode is input

Y[0] = INPUT();


--Y[1] is Y[1] at PIN_P7
--operation mode is input

Y[1] = INPUT();


--X[3] is X[3] at PIN_D22
--operation mode is input

X[3] = INPUT();


--X[2] is X[2] at PIN_C20
--operation mode is input

X[2] = INPUT();


--Y[2] is Y[2] at PIN_E20
--operation mode is input

Y[2] = INPUT();


--Y[3] is Y[3] at PIN_B20
--operation mode is input

Y[3] = INPUT();


--XMY is XMY at PIN_M16
--operation mode is output

XMY = OUTPUT(B2L3);


--XLY is XLY at PIN_E19
--operation mode is output

XLY = OUTPUT(B2L2);


--XEY is XEY at PIN_D21
--operation mode is output

XEY = OUTPUT(!B2L1);



