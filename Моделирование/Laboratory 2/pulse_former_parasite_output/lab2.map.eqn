--A1L1 is inst5~4
A1L1_p1_out = A1L1 & pluse_former_parasite_out_in;
A1L1_or_out = A1L1_p1_out;
A1L1 = !(A1L1_or_out);


--A1L2 is inst5~6
A1L2_or_out = !A1L1;
A1L2 = A1L2_or_out;


--pluse_former_parasite_out_in is pluse_former_parasite_out_in
--operation mode is input

pluse_former_parasite_out_in = INPUT();


--pluse_former_parasite_out_output_y is pluse_former_parasite_out_output_y
--operation mode is output

pluse_former_parasite_out_output_y = OUTPUT(A1L1);


--pluse_former_parasite_out_output_x is pluse_former_parasite_out_output_x
--operation mode is output

pluse_former_parasite_out_output_x = OUTPUT(A1L2);


