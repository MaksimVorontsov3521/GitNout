--inst7 is inst7
inst7_or_out = pluse_former_in;
inst7 = inst7_or_out;


--inst8 is inst8
inst8_or_out = !inst7;
inst8 = inst8_or_out;


--A1L1 is inst6~8
A1L1_p1_out = inst8 & pluse_former_in;
A1L1_or_out = A1L1_p1_out;
A1L1 = !(A1L1_or_out);


--pluse_former_in is pluse_former_in
--operation mode is input

pluse_former_in = INPUT();


--pluse_former_out is pluse_former_out
--operation mode is output

pluse_former_out = OUTPUT(A1L1);


