--inst6 is inst6
inst6_or_out = !pluse_former_XOR_in;
inst6 = inst6_or_out;


--inst9 is inst9
inst9_or_out = inst6;
inst9 = inst9_or_out;


--A1L1 is inst4~0
A1L1_or_out = pluse_former_XOR_in;
A1L1 = !inst9 $ A1L1_or_out;


--pluse_former_XOR_in is pluse_former_XOR_in
--operation mode is input

pluse_former_XOR_in = INPUT();


--pluse_former_XOR_out is pluse_former_XOR_out
--operation mode is output

pluse_former_XOR_out = OUTPUT(A1L1);


