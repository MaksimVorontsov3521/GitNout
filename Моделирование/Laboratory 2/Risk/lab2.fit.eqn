--inst7 is inst7 at LC3
inst7_or_out = Risk_A;
inst7 = inst7_or_out;


--inst5 is inst5 at LC1
inst5_or_out = !Risk_A;
inst5 = inst5_or_out;


--inst6 is inst6 at LC5
inst6_or_out = inst5;
inst6 = inst6_or_out;


--A1L4 is inst9~0 at LC6
A1L4_p1_out = inst7 & inst6;
A1L4_or_out = A1L4_p1_out;
A1L4 = !(A1L4_or_out);


--Risk_A is Risk_A at PIN_81
--operation mode is input

Risk_A = INPUT();


--Risk_X1 is Risk_X1 at PIN_12
--operation mode is output

Risk_X1 = OUTPUT(inst7);


--Risk_X2 is Risk_X2 at PIN_11
--operation mode is output

Risk_X2 = OUTPUT(inst6);


--Risk_B is Risk_B at PIN_10
--operation mode is output

Risk_B = OUTPUT(A1L4);






