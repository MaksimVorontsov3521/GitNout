--inst10 is inst10 at LC1
inst10_p1_out = !inst13 & !pluse_gen_in;
inst10_or_out = inst10_p1_out;
inst10 = inst10_or_out;


--inst11 is inst11 at LC2
inst11_or_out = inst10;
inst11 = inst11_or_out;


--inst12 is inst12 at LC4
inst12_or_out = inst11;
inst12 = inst12_or_out;


--inst13 is inst13 at LC3
inst13_or_out = inst12;
inst13 = inst13_or_out;


--pluse_gen_in is pluse_gen_in at PIN_33
--operation mode is input

pluse_gen_in = INPUT();


--pluse_gen_out is pluse_gen_out at PIN_12
--operation mode is output

pluse_gen_out = OUTPUT(inst13);






