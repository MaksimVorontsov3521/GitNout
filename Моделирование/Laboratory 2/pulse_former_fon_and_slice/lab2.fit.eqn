--inst12 is inst12 at LC1
inst12_or_out = !pluse_former_fon_and_slice_in;
inst12 = inst12_or_out;


--inst14 is inst14 at LC2
inst14_or_out = !inst12;
inst14 = inst14_or_out;


--inst15 is inst15 at LC4
inst15_or_out = !inst14;
inst15 = inst15_or_out;


--A1L2 is inst13~3 at LC3
A1L2_or_out = !pluse_former_fon_and_slice_in;
A1L2 = !inst15 $ A1L2_or_out;


--pluse_former_fon_and_slice_in is pluse_former_fon_and_slice_in at PIN_33
--operation mode is input

pluse_former_fon_and_slice_in = INPUT();


--pluse_former_fon_and_slice_out is pluse_former_fon_and_slice_out at PIN_12
--operation mode is output

pluse_former_fon_and_slice_out = OUTPUT(A1L2);






