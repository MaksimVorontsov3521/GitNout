--D1_inst is 2-stroke_two-digit_shift_register:inst|2-stroke_D-trigger:inst|inst
D1_inst_or_out = D;
D1_inst_reg_input = D1_inst_or_out;
D1_inst = DFFE(D1_inst_reg_input, GLOBAL(C1), GLOBAL(R), , );


--D1_inst4 is 2-stroke_two-digit_shift_register:inst|2-stroke_D-trigger:inst|inst4
D1_inst4_or_out = D1_inst;
D1_inst4_reg_input = D1_inst4_or_out;
D1_inst4 = DFFE(D1_inst4_reg_input, GLOBAL(C2), GLOBAL(R), , );


--D2_inst is 2-stroke_two-digit_shift_register:inst|2-stroke_D-trigger:inst1|inst
D2_inst_or_out = D1_inst4;
D2_inst_reg_input = D2_inst_or_out;
D2_inst = DFFE(D2_inst_reg_input, GLOBAL(C1), GLOBAL(R), , );


--D1L3 is 2-stroke_two-digit_shift_register:inst|2-stroke_D-trigger:inst|inst4~4
D1L3_or_out = D1_inst4;
D1L3 = D1L3_or_out;


--D2_inst4 is 2-stroke_two-digit_shift_register:inst|2-stroke_D-trigger:inst1|inst4
D2_inst4_or_out = D2_inst;
D2_inst4_reg_input = D2_inst4_or_out;
D2_inst4 = DFFE(D2_inst4_reg_input, GLOBAL(C2), GLOBAL(R), , );


--D2L3 is 2-stroke_two-digit_shift_register:inst|2-stroke_D-trigger:inst1|inst4~2
D2L3_or_out = D2_inst4;
D2L3 = D2L3_or_out;


--D is D
--operation mode is input

D = INPUT();


--C1 is C1
--operation mode is input

C1 = INPUT();


--C2 is C2
--operation mode is input

C2 = INPUT();


--R is R
--operation mode is input

R = INPUT();


--Q1BDF is Q1BDF
--operation mode is output

Q1BDF = OUTPUT(D1_inst4);


--Q1VHD is Q1VHD
--operation mode is output

Q1VHD = OUTPUT(D1L3);


--Q2BDF is Q2BDF
--operation mode is output

Q2BDF = OUTPUT(D2_inst4);


--Q2VHD is Q2VHD
--operation mode is output

Q2VHD = OUTPUT(D2L3);


