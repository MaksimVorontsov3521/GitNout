--B1_inst is 2-stroke_D-trigger:inst3|inst at LC3
B1_inst_or_out = D;
B1_inst_reg_input = B1_inst_or_out;
B1_inst = DFFE(B1_inst_reg_input, GLOBAL(C1), GLOBAL(R), , );


--B1_inst4 is 2-stroke_D-trigger:inst3|inst4 at LC5
B1_inst4_or_out = B1_inst;
B1_inst4_reg_input = B1_inst4_or_out;
B1_inst4 = DFFE(B1_inst4_reg_input, GLOBAL(C2), GLOBAL(R), , );


--B2_inst is 2-stroke_D-trigger:inst4|inst at LC6
B2_inst_or_out = B1_inst4;
B2_inst_reg_input = B2_inst_or_out;
B2_inst = DFFE(B2_inst_reg_input, GLOBAL(C1), GLOBAL(R), , );


--B2_inst4 is 2-stroke_D-trigger:inst4|inst4 at LC8
B2_inst4_or_out = B2_inst;
B2_inst4_reg_input = B2_inst4_or_out;
B2_inst4 = DFFE(B2_inst4_reg_input, GLOBAL(C2), GLOBAL(R), , );


--D is D at PIN_81
--operation mode is input

D = INPUT();


--C1 is C1 at PIN_83
--operation mode is input

C1 = INPUT();


--C2 is C2 at PIN_2
--operation mode is input

C2 = INPUT();


--R is R at PIN_1
--operation mode is input

R = INPUT();


--Q11 is Q11 at PIN_12
--operation mode is output

Q11 = OUTPUT(B1_inst);


--Q1 is Q1 at PIN_11
--operation mode is output

Q1 = OUTPUT(B1_inst4);


--Q22 is Q22 at PIN_10
--operation mode is output

Q22 = OUTPUT(B2_inst);


--Q2 is Q2 at PIN_9
--operation mode is output

Q2 = OUTPUT(B2_inst4);






