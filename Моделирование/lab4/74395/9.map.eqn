--B1_20 is 74395:inst|20
--operation mode is normal

B1_20_lut_out = Load & D4 # !Load & (B1_15);
B1_20 = DFFEAS(B1_20_lut_out, !CLK, CLRN, , , , , , );


--B1_7 is 74395:inst|7
--operation mode is normal

B1_7_lut_out = Load & D1 # !Load & (Ser);
B1_7 = DFFEAS(B1_7_lut_out, !CLK, CLRN, , , , , , );


--B1_10 is 74395:inst|10
--operation mode is normal

B1_10_lut_out = Load & D2 # !Load & (B1_7);
B1_10 = DFFEAS(B1_10_lut_out, !CLK, CLRN, , , , , , );


--B1_15 is 74395:inst|15
--operation mode is normal

B1_15_lut_out = Load & D3 # !Load & (B1_10);
B1_15 = DFFEAS(B1_15_lut_out, !CLK, CLRN, , , , , , );


--OEN is OEN
--operation mode is input

OEN = INPUT();


--D4 is D4
--operation mode is input

D4 = INPUT();


--Load is Load
--operation mode is input

Load = INPUT();


--CLK is CLK
--operation mode is input

CLK = INPUT();


--CLRN is CLRN
--operation mode is input

CLRN = INPUT();


--D1 is D1
--operation mode is input

D1 = INPUT();


--Ser is Ser
--operation mode is input

Ser = INPUT();


--D2 is D2
--operation mode is input

D2 = INPUT();


--D3 is D3
--operation mode is input

D3 = INPUT();


--Q1 is Q1
--operation mode is output

Q1_tri_out = TRI(B1_7, !OEN);
Q1 = OUTPUT(Q1_tri_out);


--Q2 is Q2
--operation mode is output

Q2_tri_out = TRI(B1_10, !OEN);
Q2 = OUTPUT(Q2_tri_out);


--Q3 is Q3
