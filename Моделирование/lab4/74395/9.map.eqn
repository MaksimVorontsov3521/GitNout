Q3_tri_out = TRI(B1_15, !OEN);
Q3 = OUTPUT(Q3_tri_out);


--Q4 is Q4
--operation mode is output

Q4_tri_out = TRI(B1_20, !OEN);
Q4 = OUTPUT(Q4_tri_out);


--S is S
--operation mode is output

S = OUTPUT(B1_20);


