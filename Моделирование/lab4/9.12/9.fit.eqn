--inst is inst at LC1
inst_or_out = D;
inst_reg_input = inst_or_out;
inst = DFFE(inst_reg_input, GLOBAL(C1), GLOBAL(R), , );


--inst4 is inst4 at LC3
inst4_or_out = inst;
inst4_reg_input = inst4_or_out;
inst4 = DFFE(inst4_reg_input, GLOBAL(C2), GLOBAL(R), , );


--R is R at PIN_1
--operation mode is input

R = INPUT();


--C2 is C2 at PIN_83
--operation mode is input

C2 = INPUT();


--C1 is C1 at PIN_2
--operation mode is input

C1 = INPUT();


--D is D at PIN_4
--operation mode is input

D = INPUT();


--Q is Q at PIN_12
--operation mode is output

Q = OUTPUT(inst4);






