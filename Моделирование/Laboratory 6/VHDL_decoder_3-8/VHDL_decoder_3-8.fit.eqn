--A1L51 is q~134 at LC6
A1L51_p1_out = !a[1] & !a[2] & !a[0] & en;
A1L51_or_out = A1L51_p1_out;
A1L51 = A1L51_or_out;


--A1L61 is q~136 at LC8
A1L61_p1_out = a[1] & !a[2] & !a[0] & en;
A1L61_or_out = A1L61_p1_out;
