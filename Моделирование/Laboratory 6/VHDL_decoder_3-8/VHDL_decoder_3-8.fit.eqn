--a[0] is a[0] at PIN_80
--operation mode is input

a[0] = INPUT();


--a[1] is a[1] at PIN_33
--operation mode is input

a[1] = INPUT();


--a[2] is a[2] at PIN_81
--operation mode is input

a[2] = INPUT();


--en is en at PIN_52
--operation mode is input

en = INPUT();


--q[0] is q[0] at PIN_10
--operation mode is output

q[0] = OUTPUT(A1L51);


