--operation mode is output

y4 = OUTPUT(B1L2);


--y5 is y5
--operation mode is output

y5 = OUTPUT(B1L6);


--y6 is y6
--operation mode is output

y6 = OUTPUT(B1L4);


--y7 is y7
--operation mode is output

y7 = OUTPUT(B1L8);


