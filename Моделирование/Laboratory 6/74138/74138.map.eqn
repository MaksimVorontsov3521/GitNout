--B1L1 is 74138:inst|15~91
B1L1_p1_out = !a & !c & !b;
B1L1_or_out = B1L1_p1_out;
B1L1 = !(B1L1_or_out);


--B1L2 is 74138:inst|15~94
B1L2_p1_out = !a & c & !b;
B1L2_or_out = B1L2_p1_out;
B1L2 = !(B1L2_or_out);


--B1L3 is 74138:inst|15~97
B1L3_p1_out = !c & !a & b;
B1L3_or_out = B1L3_p1_out;
B1L3 = !(B1L3_or_out);


--B1L4 is 74138:inst|15~100
B1L4_p1_out = c & !a & b;
B1L4_or_out = B1L4_p1_out;
B1L4 = !(B1L4_or_out);


--B1L5 is 74138:inst|15~103
B1L5_p1_out = a & !c & !b;
B1L5_or_out = B1L5_p1_out;
B1L5 = !(B1L5_or_out);


--B1L6 is 74138:inst|15~106
B1L6_p1_out = a & c & !b;
B1L6_or_out = B1L6_p1_out;
B1L6 = !(B1L6_or_out);


--B1L7 is 74138:inst|15~109
B1L7_p1_out = !c & a & b;
B1L7_or_out = B1L7_p1_out;
B1L7 = !(B1L7_or_out);


--B1L8 is 74138:inst|15~112
B1L8_p1_out = c & a & b;
B1L8_or_out = B1L8_p1_out;
B1L8 = !(B1L8_or_out);


--a is a
--operation mode is input

a = INPUT();


--b is b
--operation mode is input

b = INPUT();


--c is c
--operation mode is input

c = INPUT();


--y0 is y0
--operation mode is output

y0 = OUTPUT(B1L1);


--y1 is y1
--operation mode is output

y1 = OUTPUT(B1L5);


--y2 is y2
--operation mode is output

y2 = OUTPUT(B1L3);


--y3 is y3
--operation mode is output

y3 = OUTPUT(B1L7);


