--A1L52 is T3~88 at LC_X25_Y30_N6
--operation mode is normal

A1L52 = IN[1] $ IN[6] $ IN[5] $ IN[2];


--A1L42 is S3~69 at LC_X25_Y30_N8
--operation mode is normal

A1L42 = IN[1] $ IN[7] $ IN[5] $ IN[3];


--A1L62 is W3~28 at LC_X25_Y30_N3
--operation mode is normal

A1L62 = IN[3] $ IN[4] $ IN[1] $ IN[2];


--A1L32 is Q7~17 at LC_X25_Y30_N4
--operation mode is normal

A1L32 = IN[6] $ IN[7] $ IN[5] $ IN[0];


--A1L6 is F1~32 at LC_X25_Y30_N7
--operation mode is normal

A1L6 = A1L32 & !A1L62 & (A1L52 # A1L42) # !A1L32 & (A1L62);


--A1L7 is F2~17 at LC_X25_Y30_N5
--operation mode is normal

A1L7 = A1L32 & (A1L62) # !A1L32 & !A1L62 & (A1L52 # A1L42);


--C3 is C3 at LC_X25_Y30_N9
--operation mode is normal

C3 = IN[1] $ (A1L62 & A1L52 & A1L42);


--C2 is C2 at LC_X25_Y30_N2
--operation mode is normal

C2 = IN[2] $ (!A1L42 & A1L52 & A1L62);


--C1 is C1 at LC_X25_Y30_N1
--operation mode is normal

C1 = IN[3] $ (!A1L52 & A1L62 & A1L42);


--C0 is C0 at LC_X25_Y30_N0
--operation mode is normal

C0 = IN[5] $ (A1L62 # !A1L42 # !A1L52);


--IN[1] is IN[1] at PIN_D13
--operation mode is input

IN[1] = INPUT();


--IN[2] is IN[2] at PIN_C12
--operation mode is input

IN[2] = INPUT();


--IN[6] is IN[6] at PIN_B11
--operation mode is input

IN[6] = INPUT();


--IN[5] is IN[5] at PIN_A11
--operation mode is input

IN[5] = INPUT();


--IN[3] is IN[3] at PIN_D12
--operation mode is input

IN[3] = INPUT();


--IN[7] is IN[7] at PIN_B14
--operation mode is input

IN[7] = INPUT();


--IN[4] is IN[4] at PIN_E13
--operation mode is input

IN[4] = INPUT();


--IN[0] is IN[0] at PIN_C13
--operation mode is input

IN[0] = INPUT();


--ONE_ERR is ONE_ERR at PIN_A15
--operation mode is output

ONE_ERR = OUTPUT(A1L6);


--DBL_ERR is DBL_ERR at PIN_B12
--operation mode is output

DBL_ERR = OUTPUT(A1L7);


--OUT_DATA[3] is OUT_DATA[3] at PIN_C14
--operation mode is output

OUT_DATA[3] = OUTPUT(C3);


--OUT_DATA[2] is OUT_DATA[2] at PIN_G9
--operation mode is output

OUT_DATA[2] = OUTPUT(C2);


--OUT_DATA[1] is OUT_DATA[1] at PIN_B13
--operation mode is output

OUT_DATA[1] = OUTPUT(C1);


--OUT_DATA[0] is OUT_DATA[0] at PIN_A12
--operation mode is output

OUT_DATA[0] = OUTPUT(!C0);



