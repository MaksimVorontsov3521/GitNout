--X2 is X2
--operation mode is normal

X2 = D1 $ D3 $ D0;


--X4 is X4
--operation mode is normal

X4 = D3 $ D0 $ D2;


--X6 is X6
--operation mode is normal

X6 = D1 $ D3 $ D2;


--A1L21 is X12~4
--operation mode is normal

A1L21 = D1 $ D0 $ D2;


--D1 is D1
--operation mode is input

D1 = INPUT();


--D3 is D3
--operation mode is input

D3 = INPUT();


--D0 is D0
--operation mode is input

D0 = INPUT();


--D2 is D2
--operation mode is input

D2 = INPUT();


--K1 is K1
--operation mode is output

K1 = OUTPUT(X2);


--K2 is K2
--operation mode is output

K2 = OUTPUT(X4);


--K3 is K3
--operation mode is output

K3 = OUTPUT(X6);


--K is K
--operation mode is output

K = OUTPUT(A1L21);


