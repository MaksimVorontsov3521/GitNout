--B1L4 is encoder:U1|K~7 at LC_X33_Y1_N2
--operation mode is normal

B1L4 = D2 $ D1 $ D0;


--B1_K3 is encoder:U1|K3 at LC_X33_Y1_N6
--operation mode is normal

B1_K3 = D1 $ D2 $ D3;


--B1_K2 is encoder:U1|K2 at LC_X33_Y1_N7
--operation mode is normal

B1_K2 = D0 $ D2 $ D3;


--B1_K1 is encoder:U1|K1 at LC_X33_Y1_N5
--operation mode is normal

B1_K1 = D1 $ D0 $ D3;


--C1_DATA_OUT[0] is error_injector:U2|DATA_OUT[0] at LC_X33_Y1_N3
--operation mode is normal

C1_DATA_OUT[0] = ERROR_MASK[0] $ D2 $ D1 $ D0;


--C1_DATA_OUT[1] is error_injector:U2|DATA_OUT[1] at LC_X34_Y1_N2
--operation mode is normal

C1_DATA_OUT[1] = ERROR_MASK[1] $ (D3);


--C1_DATA_OUT[2] is error_injector:U2|DATA_OUT[2] at LC_X33_Y1_N8
--operation mode is normal

C1_DATA_OUT[2] = ERROR_MASK[2] $ D2;


--C1_DATA_OUT[3] is error_injector:U2|DATA_OUT[3] at LC_X36_Y1_N2
--operation mode is normal

C1_DATA_OUT[3] = ERROR_MASK[3] $ D1;


--C1_DATA_OUT[4] is error_injector:U2|DATA_OUT[4] at LC_X33_Y1_N9
--operation mode is normal

C1_DATA_OUT[4] = ERROR_MASK[4] $ D2 $ D1 $ D3;


--C1_DATA_OUT[5] is error_injector:U2|DATA_OUT[5] at LC_X33_Y1_N4
--operation mode is normal

C1_DATA_OUT[5] = D0 $ (ERROR_MASK[5]);


--C1_DATA_OUT[6] is error_injector:U2|DATA_OUT[6] at LC_X33_Y1_N1
--operation mode is normal

C1_DATA_OUT[6] = D3 $ D0 $ D2 $ ERROR_MASK[6];


--C1_DATA_OUT[7] is error_injector:U2|DATA_OUT[7] at LC_X33_Y1_N0
--operation mode is normal

C1_DATA_OUT[7] = D3 $ ERROR_MASK[7] $ D1 $ D0;


--D1L01 is decoder:U3|P3~25 at LC_X35_Y1_N6
--operation mode is normal

D1L01 = ERROR_MASK[2] $ ERROR_MASK[1] $ ERROR_MASK[3] $ ERROR_MASK[4];


--D1L8 is decoder:U3|P1~34 at LC_X35_Y1_N2
--operation mode is normal

D1L8 = ERROR_MASK[3] $ ERROR_MASK[5] $ ERROR_MASK[1] $ ERROR_MASK[7];


--D1L9 is decoder:U3|P2~15 at LC_X35_Y1_N7
--operation mode is normal

D1L9 = ERROR_MASK[6] $ ERROR_MASK[5] $ ERROR_MASK[1] $ ERROR_MASK[2];


--D1L4 is decoder:U3|OUT_DATA[0]~402 at LC_X35_Y1_N1
--operation mode is normal

D1L4 = C1_DATA_OUT[5] $ (D1L9 & !D1L01 & D1L8);


--D1L5 is decoder:U3|OUT_DATA[1]~403 at LC_X35_Y1_N0
--operation mode is normal

D1L5 = C1_DATA_OUT[3] $ (!D1L9 & D1L01 & D1L8);


--D1L6 is decoder:U3|OUT_DATA[2]~404 at LC_X35_Y1_N9
--operation mode is normal

D1L6 = C1_DATA_OUT[2] $ (D1L9 & D1L01 & !D1L8);


--D1L7 is decoder:U3|OUT_DATA[3]~405 at LC_X35_Y1_N8
--operation mode is normal

D1L7 = C1_DATA_OUT[1] $ (D1L9 & D1L01 & D1L8);


--D1L2 is decoder:U3|KP~26 at LC_X35_Y1_N4
--operation mode is normal

D1L2 = ERROR_MASK[6] $ ERROR_MASK[5] $ ERROR_MASK[0] $ ERROR_MASK[7];


--D1L3 is decoder:U3|ONE_ERR~33 at LC_X35_Y1_N3
--operation mode is normal

D1L3 = D1L01 & (!D1L2) # !D1L01 & D1L2 & (D1L9 # D1L8);


--D1L1 is decoder:U3|DBL_ERR~24 at LC_X35_Y1_N5
--operation mode is normal

D1L1 = D1L01 & (D1L2) # !D1L01 & !D1L2 & (D1L9 # D1L8);


--D0 is D0 at PIN_AB7
--operation mode is input

D0 = INPUT();


--D2 is D2 at PIN_Y13
--operation mode is input

D2 = INPUT();


--D1 is D1 at PIN_V6
--operation mode is input

D1 = INPUT();


--D3 is D3 at PIN_K8
--operation mode is input

D3 = INPUT();


--ERROR_MASK[0] is ERROR_MASK[0] at PIN_U9
--operation mode is input

ERROR_MASK[0] = INPUT();


--ERROR_MASK[1] is ERROR_MASK[1] at PIN_AA11
--operation mode is input

ERROR_MASK[1] = INPUT();


--ERROR_MASK[2] is ERROR_MASK[2] at PIN_P10
--operation mode is input

ERROR_MASK[2] = INPUT();


--ERROR_MASK[3] is ERROR_MASK[3] at PIN_Y9
--operation mode is input

ERROR_MASK[3] = INPUT();


--ERROR_MASK[4] is ERROR_MASK[4] at PIN_P9
--operation mode is input

ERROR_MASK[4] = INPUT();


--ERROR_MASK[5] is ERROR_MASK[5] at PIN_AB11
--operation mode is input

ERROR_MASK[5] = INPUT();


--ERROR_MASK[6] is ERROR_MASK[6] at PIN_M8
--operation mode is input

ERROR_MASK[6] = INPUT();


--ERROR_MASK[7] is ERROR_MASK[7] at PIN_Y8
--operation mode is input

ERROR_MASK[7] = INPUT();


--CODE[0] is CODE[0] at PIN_AA13
--operation mode is output

CODE[0] = OUTPUT(B1L4);


--CODE[1] is CODE[1] at PIN_H10
--operation mode is output

CODE[1] = OUTPUT(D3);


--CODE[2] is CODE[2] at PIN_W12
--operation mode is output

CODE[2] = OUTPUT(D2);


--CODE[3] is CODE[3] at PIN_U6
--operation mode is output

CODE[3] = OUTPUT(D1);


--CODE[4] is CODE[4] at PIN_T9
--operation mode is output

CODE[4] = OUTPUT(B1_K3);


--CODE[5] is CODE[5] at PIN_AB8
--operation mode is output

CODE[5] = OUTPUT(D0);


--CODE[6] is CODE[6] at PIN_T10
--operation mode is output

CODE[6] = OUTPUT(B1_K2);


--CODE[7] is CODE[7] at PIN_Y12
--operation mode is output

CODE[7] = OUTPUT(B1_K1);


--RX[0] is RX[0] at PIN_AB12
--operation mode is output

RX[0] = OUTPUT(C1_DATA_OUT[0]);


--RX[1] is RX[1] at PIN_AA8
--operation mode is output

RX[1] = OUTPUT(C1_DATA_OUT[1]);


--RX[2] is RX[2] at PIN_V9
--operation mode is output

RX[2] = OUTPUT(C1_DATA_OUT[2]);


--RX[3] is RX[3] at PIN_P8
--operation mode is output

RX[3] = OUTPUT(C1_DATA_OUT[3]);


--RX[4] is RX[4] at PIN_N10
--operation mode is output

RX[4] = OUTPUT(C1_DATA_OUT[4]);


--RX[5] is RX[5] at PIN_N8
--operation mode is output

RX[5] = OUTPUT(C1_DATA_OUT[5]);


--RX[6] is RX[6] at PIN_AA12
--operation mode is output

RX[6] = OUTPUT(C1_DATA_OUT[6]);


--RX[7] is RX[7] at PIN_R8
--operation mode is output

RX[7] = OUTPUT(C1_DATA_OUT[7]);


--OUT_DATA[0] is OUT_DATA[0] at PIN_M7
--operation mode is output

OUT_DATA[0] = OUTPUT(D1L4);


--OUT_DATA[1] is OUT_DATA[1] at PIN_W9
--operation mode is output

OUT_DATA[1] = OUTPUT(D1L5);


--OUT_DATA[2] is OUT_DATA[2] at PIN_T8
--operation mode is output

OUT_DATA[2] = OUTPUT(D1L6);


--OUT_DATA[3] is OUT_DATA[3] at PIN_V8
--operation mode is output

OUT_DATA[3] = OUTPUT(D1L7);


--ONE_ERR is ONE_ERR at PIN_W8
--operation mode is output

ONE_ERR = OUTPUT(D1L3);


--DBL_ERR is DBL_ERR at PIN_U8
--operation mode is output

DBL_ERR = OUTPUT(D1L1);



