--A1L01 is SK1~1 at LC_X52_Y1_N4
--operation mode is normal

A1L01 = D3 $ D1 $ D0;


--A1L11 is SK2~1 at LC_X52_Y1_N5
--operation mode is normal

A1L11 = D0 $ (D3 $ D2);


--A1L21 is SK3~1 at LC_X52_Y1_N2
--operation mode is normal

A1L21 = D3 $ D1 $ D2;


--A1L9 is K~10 at LC_X52_Y1_N6
--operation mode is normal

A1L9 = D0 $ (D1 $ D2);


--D1 is D1 at PIN_T7
--operation mode is input

D1 = INPUT();


--D3 is D3 at PIN_AA2
--operation mode is input

D3 = INPUT();


--D0 is D0 at PIN_V4
--operation mode is input

D0 = INPUT();


--D2 is D2 at PIN_V3
--operation mode is input

D2 = INPUT();


--K1 is K1 at PIN_W3
--operation mode is output

K1 = OUTPUT(A1L01);


--K2 is K2 at PIN_AA3
--operation mode is output

K2 = OUTPUT(A1L11);


--K3 is K3 at PIN_Y3
--operation mode is output

K3 = OUTPUT(A1L21);


--K is K at PIN_W4
--operation mode is output

K = OUTPUT(A1L9);



