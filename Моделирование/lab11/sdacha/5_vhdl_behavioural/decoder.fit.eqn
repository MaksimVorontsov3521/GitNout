--A1L62 is P3~24 at LC_X25_Y30_N6
--operation mode is normal

A1L62 = IN_DATA[3] $ IN_DATA[1] $ IN_DATA[4] $ IN_DATA[2];


--A1L21 is KP~37 at LC_X25_Y30_N1
--operation mode is normal

A1L21 = IN_DATA[5] $ IN_DATA[1] $ IN_DATA[7] $ IN_DATA[3];


--A1L52 is P2~24 at LC_X25_Y30_N4
--operation mode is normal

A1L52 = IN_DATA[5] $ IN_DATA[1] $ IN_DATA[6] $ IN_DATA[2];


--A1L41 is Mux~403 at LC_X25_Y30_N7
--operation mode is normal

A1L41 = IN_DATA[5] $ (!A1L62 & A1L21 & A1L52);


--A1L51 is Mux~404 at LC_X25_Y30_N5
--operation mode is normal

A1L51 = IN_DATA[3] $ (A1L62 & A1L21 & !A1L52);


--A1L61 is Mux~405 at LC_X25_Y30_N9
--operation mode is normal

A1L61 = IN_DATA[2] $ (A1L52 & A1L62 & !A1L21);


--A1L71 is Mux~406 at LC_X25_Y30_N2
--operation mode is normal

A1L71 = IN_DATA[1] $ (A1L52 & A1L62 & A1L21);


--A1L31 is KP~38 at LC_X25_Y30_N0
--operation mode is normal

A1L31 = IN_DATA[4] $ IN_DATA[0] $ IN_DATA[6] $ IN_DATA[2];


--A1L91 is ONE_ERR~33 at LC_X25_Y30_N3
--operation mode is normal

A1L91 = A1L21 & (!A1L31) # !A1L21 & A1L31 & (A1L52 # A1L62);


--A1L2 is DBL_ERR~20 at LC_X25_Y30_N8
--operation mode is normal

A1L2 = A1L21 & (A1L31) # !A1L21 & !A1L31 & (A1L52 # A1L62);


--IN_DATA[5] is IN_DATA[5] at PIN_D13
--operation mode is input

IN_DATA[5] = INPUT();


--IN_DATA[2] is IN_DATA[2] at PIN_C12
--operation mode is input

IN_DATA[2] = INPUT();


--IN_DATA[4] is IN_DATA[4] at PIN_B11
--operation mode is input

IN_DATA[4] = INPUT();


--IN_DATA[1] is IN_DATA[1] at PIN_A11
--operation mode is input

IN_DATA[1] = INPUT();


--IN_DATA[3] is IN_DATA[3] at PIN_D12
--operation mode is input

IN_DATA[3] = INPUT();


--IN_DATA[7] is IN_DATA[7] at PIN_B14
--operation mode is input

IN_DATA[7] = INPUT();


--IN_DATA[6] is IN_DATA[6] at PIN_E13
--operation mode is input

IN_DATA[6] = INPUT();


--IN_DATA[0] is IN_DATA[0] at PIN_C13
--operation mode is input

IN_DATA[0] = INPUT();


--OUT_DATA[0] is OUT_DATA[0] at PIN_A15
--operation mode is output

OUT_DATA[0] = OUTPUT(A1L41);


--OUT_DATA[1] is OUT_DATA[1] at PIN_B12
--operation mode is output

OUT_DATA[1] = OUTPUT(A1L51);


--OUT_DATA[2] is OUT_DATA[2] at PIN_C14
--operation mode is output

OUT_DATA[2] = OUTPUT(A1L61);


--OUT_DATA[3] is OUT_DATA[3] at PIN_G9
--operation mode is output

OUT_DATA[3] = OUTPUT(A1L71);


--ONE_ERR is ONE_ERR at PIN_B13
--operation mode is output

ONE_ERR = OUTPUT(A1L91);


--DBL_ERR is DBL_ERR at PIN_A12
--operation mode is output

DBL_ERR = OUTPUT(A1L2);



