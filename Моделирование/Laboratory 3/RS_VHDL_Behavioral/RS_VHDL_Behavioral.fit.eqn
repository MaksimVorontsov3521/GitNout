--A1L2 is process0~5 at LC_X25_Y1_N3
--operation mode is normal

A1L2 = !r # !s;


--A1L1 is process0~1 at LC_X25_Y1_N4
--operation mode is normal

A1L1 = s & !r;


--qs is qs at LC_X25_Y1_N2
--operation mode is normal

qs = !A1L1 & (!A1L2 & qs # !s);


--s is s at PIN_Y13
--operation mode is input

s = INPUT();


--r is r at PIN_AA13
--operation mode is input

r = INPUT();


--q is q at PIN_Y12
--operation mode is output

q = OUTPUT(qs);


--qb is qb at PIN_AA12
--operation mode is output

qb = OUTPUT(!qs);



