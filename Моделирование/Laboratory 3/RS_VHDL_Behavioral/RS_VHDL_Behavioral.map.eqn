--A1L2 is process0~5
--operation mode is normal

A1L2 = !r # !s;


--A1L1 is process0~1
--operation mode is normal

A1L1 = s & (!r);


--qs is qs
--operation mode is normal

qs = !A1L1 & (qs & !A1L2 # !s);


--s is s
--operation mode is input

s = INPUT();


--r is r
--operation mode is input

r = INPUT();


--q is q
--operation mode is output

q = OUTPUT(qs);


--qb is qb
--operation mode is output

qb = OUTPUT(!qs);


