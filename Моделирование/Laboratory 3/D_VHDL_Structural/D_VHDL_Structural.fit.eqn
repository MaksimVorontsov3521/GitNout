--B4L1 is RS_VHDL:u3|notand:u2|c~3 at LC_X52_Y1_N2
--operation mode is normal

B4L1 = B3L1 # !d & l;


--B3L1 is RS_VHDL:u3|notand:u1|c~26 at LC_X52_Y1_N4
--operation mode is normal

B3L1 = l & !d # !l & (B3L1);


--l is l at PIN_W4
--operation mode is input

l = INPUT();


--d is d at PIN_V4
--operation mode is input

d = INPUT();


--q is q at PIN_T7
--operation mode is output

q = OUTPUT(!B3L1);


--qb is qb at PIN_AA3
--operation mode is output

qb = OUTPUT(B4L1);



