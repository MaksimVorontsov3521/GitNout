--B1L2 is RS-trigger:inst3|inst3~9
--operation mode is normal

B1L2 = B1_inst # L & (!D);


--B1_inst is RS-trigger:inst3|inst
--operation mode is normal

B1_inst = L & !D # !L & (B1_inst);


--L is L
--operation mode is input

L = INPUT();


--D is D
--operation mode is input

D = INPUT();


--Q is Q
--operation mode is output

Q = OUTPUT(!B1_inst);


--QB is QB
--operation mode is output

QB = OUTPUT(B1L2);


