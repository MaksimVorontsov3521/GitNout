--qs is qs
--operation mode is normal

qs = l & d # !l & (qs);


--d is d
--operation mode is input

d = INPUT();


--l is l
--operation mode is input

l = INPUT();


--q is q
--operation mode is output

q = OUTPUT(qs);


--qb is qb
--operation mode is output

qb = OUTPUT(!qs);


