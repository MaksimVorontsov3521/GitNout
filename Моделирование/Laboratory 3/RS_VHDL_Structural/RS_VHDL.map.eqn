--B2L1 is notand:u2|c~0
--operation mode is normal

B2L1 = r & (!B1L1);


--B1L1 is notand:u1|c~0
--operation mode is normal

B1L1 = s & (B1L1 # !r);


--r is r
--operation mode is input

r = INPUT();


--s is s
--operation mode is input

s = INPUT();


--q is q
--operation mode is output

q = OUTPUT(!B1L1);


--qb is qb
--operation mode is output

qb = OUTPUT(!B2L1);


