--D4L1 is eo8:U_rx|parity2:U4|u2~54
--operation mode is normal

D4L1 = ERR7 $ ERR6 $ ERR5 $ ERR4;


--D4L2 is eo8:U_rx|parity2:U4|u2~55
--operation mode is normal

D4L2 = ERR3 $ ERR2 $ ERR1 $ ERR0;


--D4L3 is eo8:U_rx|parity2:U4|u2~56
--operation mode is normal

D4L3 = D4L1 $ D4L2 $ ERR8;


