--A1L3 is LessThan~66
--operation mode is normal

A1L3 = X3 & (X1 # X2) # !X3 & X1 & X2;


--A1L5 is Mux~22
--operation mode is normal

A1L5 = X3 $ X2;


--A1L6 is Mux~23
--operation mode is normal

A1L6 = X3 $ X1;


--X3 is X3
--operation mode is input

X3 = INPUT();


--X1 is X1
--operation mode is input

X1 = INPUT();


--X2 is X2
--operation mode is input

X2 = INPUT();


--M is M
--operation mode is output

M = OUTPUT(A1L3);


--a1 is a1
--operation mode is output

a1 = OUTPUT(A1L5);


--a0 is a0
--operation mode is output

a0 = OUTPUT(A1L6);


