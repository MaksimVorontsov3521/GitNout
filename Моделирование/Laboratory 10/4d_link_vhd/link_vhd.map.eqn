--B1_Y[0] is dtm:ch|Y[0]
--operation mode is normal

B1_Y[0] = X[0] $ ERR[0];


--B1_Y[1] is dtm:ch|Y[1]
--operation mode is normal

B1_Y[1] = X[1] $ ERR[1];


--B1_Y[2] is dtm:ch|Y[2]
--operation mode is normal

B1_Y[2] = X[2] $ ERR[2];


--B1_Y[3] is dtm:ch|Y[3]
--operation mode is normal

B1_Y[3] = X[3] $ ERR[3];


--B1_Y[4] is dtm:ch|Y[4]
--operation mode is normal

B1_Y[4] = X[4] $ ERR[4];


--B1_Y[5] is dtm:ch|Y[5]
--operation mode is normal

B1_Y[5] = X[5] $ ERR[5];


--B1_Y[6] is dtm:ch|Y[6]
--operation mode is normal

B1_Y[6] = X[6] $ ERR[6];


--B1_Y[7] is dtm:ch|Y[7]
--operation mode is normal

B1_Y[7] = X[7] $ ERR[7];


--C1L1 is eo8:rx|ODD~54
--operation mode is normal

C1L1 = ERR[0] $ ERR[1] $ ERR[2] $ ERR[3];


--C1L2 is eo8:rx|ODD~55
--operation mode is normal

C1L2 = ERR[4] $ ERR[5] $ ERR[6] $ ERR[7];


--C1L3 is eo8:rx|ODD~56
--operation mode is normal

C1L3 = C1L1 $ C1L2 $ ERR[8];


--X[0] is X[0]
--operation mode is input

X[0] = INPUT();


--ERR[0] is ERR[0]
--operation mode is input

ERR[0] = INPUT();


--X[1] is X[1]
--operation mode is input

X[1] = INPUT();


--ERR[1] is ERR[1]
--operation mode is input

ERR[1] = INPUT();


--X[2] is X[2]
--operation mode is input

X[2] = INPUT();


--ERR[2] is ERR[2]
--operation mode is input

ERR[2] = INPUT();


--X[3] is X[3]
--operation mode is input

X[3] = INPUT();


--ERR[3] is ERR[3]
--operation mode is input

ERR[3] = INPUT();


--X[4] is X[4]
--operation mode is input

X[4] = INPUT();


--ERR[4] is ERR[4]
--operation mode is input

ERR[4] = INPUT();


--X[5] is X[5]
--operation mode is input

X[5] = INPUT();


--ERR[5] is ERR[5]
--operation mode is input

ERR[5] = INPUT();


--X[6] is X[6]
--operation mode is input

X[6] = INPUT();


--ERR[6] is ERR[6]
--operation mode is input

ERR[6] = INPUT();


--X[7] is X[7]
--operation mode is input

X[7] = INPUT();


--ERR[7] is ERR[7]
--operation mode is input

ERR[7] = INPUT();


--ERR[8] is ERR[8]
--operation mode is input

ERR[8] = INPUT();


--Outp[0] is Outp[0]
--operation mode is output

Outp[0] = OUTPUT(B1_Y[0]);


--Outp[1] is Outp[1]
--operation mode is output

Outp[1] = OUTPUT(B1_Y[1]);


--Outp[2] is Outp[2]
--operation mode is output

Outp[2] = OUTPUT(B1_Y[2]);


--Outp[3] is Outp[3]
--operation mode is output

Outp[3] = OUTPUT(B1_Y[3]);


--Outp[4] is Outp[4]
--operation mode is output

Outp[4] = OUTPUT(B1_Y[4]);


--Outp[5] is Outp[5]
--operation mode is output

Outp[5] = OUTPUT(B1_Y[5]);


--Outp[6] is Outp[6]
--operation mode is output

Outp[6] = OUTPUT(B1_Y[6]);


--Outp[7] is Outp[7]
--operation mode is output

Outp[7] = OUTPUT(B1_Y[7]);


--ERROR is ERROR
--operation mode is output

ERROR = OUTPUT(C1L3);


--OK is OK
--operation mode is output

OK = OUTPUT(!C1L3);


