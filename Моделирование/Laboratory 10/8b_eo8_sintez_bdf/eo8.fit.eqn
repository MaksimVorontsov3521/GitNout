--B4L1 is parity2:U4|u2~53 at LC_X9_Y1_N4
--operation mode is normal

B4L1 = X2 $ X7 $ X0 $ X1;


--B4L2 is parity2:U4|u2~54 at LC_X9_Y1_N2
--operation mode is normal

B4L2 = X3 $ X4 $ X8 $ X5;


--B4L3 is parity2:U4|u2~55 at LC_X9_Y1_N5
--operation mode is normal

B4L3 = B4L1 $ X6 $ (B4L2);


--X1 is X1 at PIN_AA16
--operation mode is input

X1 = INPUT();


--X2 is X2 at PIN_W16
--operation mode is input

X2 = INPUT();


--X7 is X7 at PIN_U17
--operation mode is input

X7 = INPUT();


--X0 is X0 at PIN_V17
--operation mode is input

X0 = INPUT();


--X4 is X4 at PIN_N13
--operation mode is input

X4 = INPUT();


--X8 is X8 at PIN_N16
--operation mode is input

X8 = INPUT();


--X5 is X5 at PIN_AB16
--operation mode is input

X5 = INPUT();


--X3 is X3 at PIN_Y15
--operation mode is input

X3 = INPUT();


--X6 is X6 at PIN_V16
--operation mode is input

X6 = INPUT();


--EVEN is EVEN at PIN_AA15
--operation mode is output

EVEN = OUTPUT(!B4L3);


--ODD is ODD at PIN_V15
--operation mode is output

ODD = OUTPUT(B4L3);



