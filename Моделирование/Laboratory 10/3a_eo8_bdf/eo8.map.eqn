--B4L1 is parity2:U4|u2~53
--operation mode is normal

B4L1 = X1 $ X2 $ X7 $ X0;


--B4L2 is parity2:U4|u2~54
--operation mode is normal

B4L2 = X4 $ X8 $ X5 $ X3;


--B4L3 is parity2:U4|u2~55
--operation mode is normal

B4L3 = B4L1 $ B4L2 $ X6;


--X1 is X1
--operation mode is input

X1 = INPUT();


--X2 is X2
--operation mode is input

X2 = INPUT();


--X7 is X7
--operation mode is input

X7 = INPUT();


--X0 is X0
--operation mode is input

X0 = INPUT();


--X4 is X4
--operation mode is input

X4 = INPUT();


--X8 is X8
--operation mode is input

X8 = INPUT();


--X5 is X5
--operation mode is input

X5 = INPUT();


--X3 is X3
--operation mode is input

X3 = INPUT();


--X6 is X6
--operation mode is input

X6 = INPUT();


--EVEN is EVEN
--operation mode is output

EVEN = OUTPUT(!B4L3);


--ODD is ODD
--operation mode is output

ODD = OUTPUT(B4L3);


