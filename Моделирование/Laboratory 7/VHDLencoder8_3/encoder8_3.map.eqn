--A1L2 is a0~111
--operation mode is normal

A1L2 = EI & (r7 # r5 & !r6);


--A1L3 is a0~112
--operation mode is normal

A1L3 = !r4 & (r3 # r1 & !r2);


--A1L4 is a0~113
--operation mode is normal

A1L4 = A1L2 # A1L3 & EI & !r6;


--A1L41 is G~114
--operation mode is normal

A1L41 = !r3 & !r2;


--A1L6 is a1~56
--operation mode is normal

A1L6 = EI & (r6 # r7 # !A1L7);


--A1L51 is G~115
--operation mode is normal

A1L51 = !r4 & !r6 & !r5 & !r7;


--A1L9 is a2~28
--operation mode is normal

A1L9 = EI & (!A1L51);


--A1L61 is G~116
--operation mode is normal

A1L61 = r1 # !A1L51 # !A1L41 # !EI;


--A1L71 is G~117
--operation mode is normal

A1L71 = A1L61 & EI # !A1L61 & (r0);


--A1L21 is EO~21
--operation mode is normal

A1L21 = A1L61 # r0;


--A1L7 is a1~57
--operation mode is normal

A1L7 = r4 # r5 # !r3 & !r2;


--EI is EI
--operation mode is input

EI = INPUT();


--r7 is r7
--operation mode is input

r7 = INPUT();


--r5 is r5
--operation mode is input

r5 = INPUT();


--r6 is r6
--operation mode is input

r6 = INPUT();


--r3 is r3
--operation mode is input

r3 = INPUT();


--r1 is r1
--operation mode is input

r1 = INPUT();


--r2 is r2
--operation mode is input

r2 = INPUT();


--r4 is r4
--operation mode is input

r4 = INPUT();


--r0 is r0
--operation mode is input

r0 = INPUT();


--a0 is a0
--operation mode is output

a0 = OUTPUT(A1L4);


--a1 is a1
--operation mode is output

a1 = OUTPUT(A1L6);


--a2 is a2
--operation mode is output

a2 = OUTPUT(A1L9);


--G is G
--operation mode is output

G = OUTPUT(A1L71);


--EO is EO
--operation mode is output

EO = OUTPUT(!A1L21);


