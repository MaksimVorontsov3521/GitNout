--A1L2 is a0~111 at LC_X5_Y30_N9
--operation mode is normal

A1L2 = EI & (r7 # !r6 & r5);


--A1L3 is a0~112 at LC_X5_Y30_N4
--operation mode is normal

A1L3 = !r4 & (r3 # r1 & !r2);


--A1L4 is a0~113 at LC_X5_Y30_N5
--operation mode is normal

A1L4 = A1L2 # EI & !r6 & A1L3;


--A1L41 is G~114 at LC_X6_Y30_N2
--operation mode is normal

A1L41 = !r3 & !r2;


--A1L6 is a1~56 at LC_X5_Y30_N1
--operation mode is normal

A1L6 = EI & (r6 # r7 # !A1L7);


--A1L51 is G~115 at LC_X5_Y30_N7
--operation mode is normal

A1L51 = !r7 & !r6 & !r4 & !r5;


--A1L9 is a2~28 at LC_X5_Y30_N0
--operation mode is normal

A1L9 = !A1L51 & (EI);


--A1L61 is G~116 at LC_X5_Y30_N2
--operation mode is normal

A1L61 = r1 # !A1L41 # !EI # !A1L51;


--A1L71 is G~117 at LC_X5_Y30_N8
--operation mode is normal

A1L71 = A1L61 & (EI) # !A1L61 & r0;


--A1L21 is EO~21 at LC_X5_Y30_N3
--operation mode is normal

A1L21 = r0 # A1L61;


--A1L7 is a1~57 at LC_X5_Y30_N6
--operation mode is normal

A1L7 = r4 # r5 # !r2 & !r3;


--EI is EI at PIN_C21
--operation mode is input

EI = INPUT();


--r7 is r7 at PIN_C17
--operation mode is input

r7 = INPUT();


--r5 is r5 at PIN_A18
--operation mode is input

r5 = INPUT();


--r6 is r6 at PIN_B19
--operation mode is input

r6 = INPUT();


--r3 is r3 at PIN_A17
--operation mode is input

r3 = INPUT();


--r1 is r1 at PIN_E18
--operation mode is input

r1 = INPUT();


--r2 is r2 at PIN_F16
--operation mode is input

r2 = INPUT();


--r4 is r4 at PIN_D17
--operation mode is input

r4 = INPUT();


--r0 is r0 at PIN_C19
--operation mode is input

r0 = INPUT();


--a0 is a0 at PIN_C18
--operation mode is output

a0 = OUTPUT(A1L4);


--a1 is a1 at PIN_F17
--operation mode is output

a1 = OUTPUT(A1L6);


--a2 is a2 at PIN_J14
--operation mode is output

a2 = OUTPUT(A1L9);


--G is G at PIN_B18
--operation mode is output

G = OUTPUT(A1L71);


--EO is EO at PIN_D18
--operation mode is output

EO = OUTPUT(!A1L21);



