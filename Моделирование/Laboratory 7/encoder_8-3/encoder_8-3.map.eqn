--A1L51 is inst28~105
--operation mode is normal

A1L51 = EI & (r7 # r5 & !r6);


--A1L61 is inst28~106
--operation mode is normal

A1L61 = !r4 & (r3 # r1 & !r2);


--A1L71 is inst28~107
--operation mode is normal

A1L71 = A1L51 # A1L61 & EI & !r6;


--A1L21 is inst27~54
--operation mode is normal

A1L21 = !r2 & !r3;


--A1L31 is inst27~55
--operation mode is normal

A1L31 = EI & (r6 # r7 # !A1L41);


--A1L01 is inst26~23
--operation mode is normal

A1L01 = !r4 & !r6 & !r5 & !r7;


--A1L11 is inst26~24
--operation mode is normal

A1L11 = EI & (!A1L01);


--A1L9 is inst25~25
--operation mode is normal

A1L9 = A1L21 & A1L01 & !r1 & !r0;


--inst24 is inst24
--operation mode is normal

inst24 = EI & (!A1L9);


--inst25 is inst25
--operation mode is normal

inst25 = EI & A1L9;


--A1L41 is inst27~56
--operation mode is normal

A1L41 = r4 # r5 # !r2 & !r3;


--EI is EI
--operation mode is input

EI = INPUT();


--r7 is r7
--operation mode is input

r7 = INPUT();


--r5 is r5
--operation mode is input

r5 = INPUT();


--r6 is r6
--operation mode is input

r6 = INPUT();


--r3 is r3
--operation mode is input

r3 = INPUT();


--r1 is r1
--operation mode is input

r1 = INPUT();


--r2 is r2
--operation mode is input

r2 = INPUT();


--r4 is r4
--operation mode is input

r4 = INPUT();


--r0 is r0
--operation mode is input

r0 = INPUT();


--A0 is A0
--operation mode is output

A0 = OUTPUT(A1L71);


--A1 is A1
--operation mode is output

A1 = OUTPUT(A1L31);


--A2 is A2
--operation mode is output

A2 = OUTPUT(A1L11);


--G is G
--operation mode is output

G = OUTPUT(inst24);


--E0 is E0
--operation mode is output

E0 = OUTPUT(inst25);


