--A1L51 is inst28~105 at LC_X5_Y30_N9
--operation mode is normal

A1L51 = EI & (r7 # !r6 & r5);


--A1L61 is inst28~106 at LC_X5_Y30_N4
--operation mode is normal

A1L61 = !r4 & (r3 # r1 & !r2);


--A1L71 is inst28~107 at LC_X5_Y30_N5
--operation mode is normal

A1L71 = A1L51 # EI & !r6 & A1L61;


--A1L21 is inst27~54 at LC_X6_Y30_N2
--operation mode is normal

A1L21 = !r3 & !r2;


--A1L31 is inst27~55 at LC_X5_Y30_N1
--operation mode is normal

A1L31 = EI & (r6 # r7 # !A1L41);


--A1L01 is inst26~23 at LC_X5_Y30_N7
--operation mode is normal

A1L01 = !r7 & !r6 & !r4 & !r5;


--A1L11 is inst26~24 at LC_X5_Y30_N0
--operation mode is normal

A1L11 = !A1L01 & (EI);


--A1L9 is inst25~25 at LC_X5_Y30_N2
--operation mode is normal

A1L9 = A1L01 & !r0 & !r1 & A1L21;


--inst24 is inst24 at LC_X5_Y30_N8
--operation mode is normal

inst24 = EI & !A1L9;


--inst25 is inst25 at LC_X5_Y30_N3
--operation mode is normal

inst25 = EI & A1L9;


--A1L41 is inst27~56 at LC_X5_Y30_N6
--operation mode is normal

A1L41 = r4 # r5 # !r2 & !r3;


--EI is EI at PIN_C21
--operation mode is input

EI = INPUT();


--r7 is r7 at PIN_C17
--operation mode is input

r7 = INPUT();


--r5 is r5 at PIN_A18
--operation mode is input

r5 = INPUT();


--r6 is r6 at PIN_B19
--operation mode is input

r6 = INPUT();


--r3 is r3 at PIN_A17
--operation mode is input

r3 = INPUT();


--r1 is r1 at PIN_E18
--operation mode is input

r1 = INPUT();


--r2 is r2 at PIN_F16
--operation mode is input

r2 = INPUT();


--r4 is r4 at PIN_D17
--operation mode is input

r4 = INPUT();


--r0 is r0 at PIN_C19
--operation mode is input

r0 = INPUT();


--A0 is A0 at PIN_C18
--operation mode is output

A0 = OUTPUT(A1L71);


--A1 is A1 at PIN_F17
--operation mode is output

A1 = OUTPUT(A1L31);


--A2 is A2 at PIN_J14
--operation mode is output

A2 = OUTPUT(A1L11);


--G is G at PIN_B18
--operation mode is output

G = OUTPUT(inst24);


--E0 is E0 at PIN_D18
--operation mode is output

E0 = OUTPUT(inst25);



