r0 = INPUT();


--a0 is a0 at PIN_G5
--operation mode is output

a0 = OUTPUT(A1L31);


--a1 is a1 at PIN_J3
--operation mode is output

a1 = OUTPUT(A1L81);


--a2 is a2 at PIN_J6
--operation mode is output

a2 = OUTPUT(A1L32);


