--A1L7 is inst5~405 at LC_X52_Y21_N9
--operation mode is normal

A1L7 = !r10 & r9;


--A1L8 is inst5~406 at LC_X52_Y21_N6
--operation mode is normal

A1L8 = r13 # !r12 & (r11 # A1L7);


--A1L9 is inst5~407 at LC_X52_Y21_N4
--operation mode is normal

A1L9 = EL & (r15 # A1L8 & !r14);


--A1L12 is inst8~89 at LC_X52_Y21_N5
--operation mode is normal

A1L12 = !r12 & !r15 & !r14 & !r13;


--A1L41 is inst6~168 at LC_X52_Y21_N3
--operation mode is normal

A1L41 = !r10 & !r11;


--B2L2 is encoder_8-3:inst4|inst25~26 at LC_X52_Y21_N1
--operation mode is normal

B2L2 = !r9 & A1L12 & A1L41 & !r8;


--B2_inst25 is encoder_8-3:inst4|inst25 at LC_X52_Y21_N8
--operation mode is normal

B2_inst25 = B2L2 & EL;


--A1L01 is inst5~408 at LC_X52_Y23_N6
--operation mode is normal

A1L01 = !r6 & !r4;


--A1L11 is inst5~409 at LC_X52_Y23_N2
--operation mode is normal

A1L11 = A1L01 & (r3 # !r2 & r1);


--A1L21 is inst5~410 at LC_X52_Y23_N9
--operation mode is normal

A1L21 = r7 # !r6 & r5;


--A1L31 is inst5~411 at LC_X52_Y23_N7
--operation mode is normal

A1L31 = A1L9 # B2_inst25 & (A1L11 # A1L21);


--A1L51 is inst6~169 at LC_X52_Y21_N2
--operation mode is normal

A1L51 = !r14 & (A1L41 # r12 # r13);


--A1L61 is inst6~170 at LC_X52_Y23_N0
--operation mode is normal

A1L61 = !r4 & !r5 & (r3 # r2);


--A1L71 is inst6~171 at LC_X52_Y23_N8
--operation mode is normal

A1L71 = B2L2 & (r7 # r6 # A1L61);


--A1L81 is inst6~172 at LC_X52_Y21_N7
--operation mode is normal

A1L81 = EL & (r15 # A1L71 # !A1L51);


--A1L22 is inst8~90 at LC_X52_Y23_N5
--operation mode is normal

A1L22 = !r5 & !r7 & !r6 & !r4;


--A1L32 is inst8~91 at LC_X52_Y23_N1
--operation mode is normal

A1L32 = EL & (B2L2 & !A1L22 # !A1L12);


--A1L91 is inst7~47 at LC_X52_Y23_N3
--operation mode is normal

A1L91 = r3 # r2 # r1 # r0;


--A1L02 is inst7~48 at LC_X52_Y23_N4
--operation mode is normal

A1L02 = EL & (A1L91 # !A1L22 # !B2L2);


--EL is EL at PIN_G2
--operation mode is input

EL = INPUT();


--r15 is r15 at PIN_J2
--operation mode is input

r15 = INPUT();


--r13 is r13 at PIN_L3
--operation mode is input

r13 = INPUT();


--r11 is r11 at PIN_L1
--operation mode is input

r11 = INPUT();


