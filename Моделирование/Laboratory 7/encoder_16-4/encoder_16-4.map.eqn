--A1L7 is inst5~405
--operation mode is normal

A1L7 = r9 & (!r10);


--A1L8 is inst5~406
--operation mode is normal

A1L8 = r13 # !r12 & (r11 # A1L7);


--A1L9 is inst5~407
--operation mode is normal

A1L9 = EL & (r15 # A1L8 & !r14);


--A1L12 is inst8~89
--operation mode is normal

A1L12 = !r13 & !r12 & !r15 & !r14;


--A1L41 is inst6~168
--operation mode is normal

A1L41 = !r10 & !r11;


--B2L2 is encoder_8-3:inst4|inst25~26
--operation mode is normal

B2L2 = A1L12 & A1L41 & !r8 & !r9;


--B2_inst25 is encoder_8-3:inst4|inst25
--operation mode is normal

B2_inst25 = EL & B2L2;


--A1L01 is inst5~408
--operation mode is normal

A1L01 = !r6 & !r4;


--A1L11 is inst5~409
--operation mode is normal

A1L11 = A1L01 & (r3 # r1 & !r2);


--A1L21 is inst5~410
--operation mode is normal

A1L21 = r7 # r5 & (!r6);


--A1L31 is inst5~411
--operation mode is normal

A1L31 = A1L9 # B2_inst25 & (A1L11 # A1L21);


--A1L51 is inst6~169
--operation mode is normal

A1L51 = !r14 & (r13 # r12 # A1L41);


--A1L61 is inst6~170
--operation mode is normal

A1L61 = !r4 & !r5 & (r2 # r3);


--A1L71 is inst6~171
--operation mode is normal

A1L71 = B2L2 & (r6 # r7 # A1L61);


--A1L81 is inst6~172
--operation mode is normal

A1L81 = EL & (r15 # A1L71 # !A1L51);


--A1L22 is inst8~90
--operation mode is normal

A1L22 = !r6 & !r4 & !r5 & !r7;


--A1L32 is inst8~91
--operation mode is normal

A1L32 = EL & (B2L2 & !A1L22 # !A1L12);


--A1L91 is inst7~47
--operation mode is normal

A1L91 = r2 # r1 # r3 # r0;


--A1L02 is inst7~48
--operation mode is normal

A1L02 = EL & (A1L91 # !A1L22 # !B2L2);


--EL is EL
--operation mode is input

EL = INPUT();


--r15 is r15
--operation mode is input

r15 = INPUT();


--r13 is r13
--operation mode is input

r13 = INPUT();


--r11 is r11
--operation mode is input

r11 = INPUT();


--r9 is r9
--operation mode is input

r9 = INPUT();


--r10 is r10
--operation mode is input

r10 = INPUT();


--r12 is r12
--operation mode is input

r12 = INPUT();


--r14 is r14
--operation mode is input

r14 = INPUT();


--r8 is r8
--operation mode is input

r8 = INPUT();


--r6 is r6
--operation mode is input

r6 = INPUT();


--r4 is r4
--operation mode is input

r4 = INPUT();


--r3 is r3
--operation mode is input

r3 = INPUT();


--r1 is r1
--operation mode is input

r1 = INPUT();


--r2 is r2
--operation mode is input

r2 = INPUT();


--r7 is r7
--operation mode is input

r7 = INPUT();


--r5 is r5
--operation mode is input

r5 = INPUT();


--r0 is r0
--operation mode is input

r0 = INPUT();


--a0 is a0
--operation mode is output

a0 = OUTPUT(A1L31);


--a1 is a1
--operation mode is output

a1 = OUTPUT(A1L81);


--a2 is a2
--operation mode is output

a2 = OUTPUT(A1L32);


--a3 is a3
--operation mode is output

a3 = OUTPUT(!B2_inst25);


--G is G
--operation mode is output

G = OUTPUT(A1L02);


