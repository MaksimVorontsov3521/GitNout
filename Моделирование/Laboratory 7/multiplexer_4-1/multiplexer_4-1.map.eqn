--A1L8 is inst~125
--operation mode is normal

A1L8 = A & (D1 # B & D3) # !A & B;


--A1L9 is inst~126
--operation mode is normal

A1L9 = A & (A1L8) # !A & (A1L8 & D2 # !A1L8 & (D0));


--D2 is D2
--operation mode is input

D2 = INPUT();


--D0 is D0
--operation mode is input

D0 = INPUT();


--A is A
--operation mode is input

A = INPUT();


--B is B
--operation mode is input

B = INPUT();


--D3 is D3
--operation mode is input

D3 = INPUT();


--D1 is D1
--operation mode is input

D1 = INPUT();


--F is F
--operation mode is output

F = OUTPUT(A1L9);


