--A1L31 is inst9~356 at LC_X46_Y30_N9
--operation mode is normal

A1L31 = C & D7 # !C & (D6);


--A1L41 is inst9~357 at LC_X46_Y30_N4
--operation mode is normal

A1L41 = C & D3 # !C & (D2);


--A1L51 is inst9~358 at LC_X46_Y30_N5
--operation mode is normal

A1L51 = B & (A & (A1L31) # !A & A1L41);


--A1L61 is inst9~359 at LC_X46_Y30_N2
--operation mode is normal

A1L61 = !B & (C & D5 # !C & (D4));


--A1L71 is inst9~360 at LC_X46_Y30_N6
--operation mode is normal

A1L71 = !B & (C & (D1) # !C & D0);


--A1L81 is inst9~361 at LC_X46_Y30_N8
--operation mode is normal

A1L81 = A1L51 # A & A1L61 # !A & (A1L71);


--B is B at PIN_A8
--operation mode is input

B = INPUT();


--D7 is D7 at PIN_E6
--operation mode is input

D7 = INPUT();


--D6 is D6 at PIN_F7
--operation mode is input

D6 = INPUT();


--C is C at PIN_A6
--operation mode is input

C = INPUT();


--D3 is D3 at PIN_D7
--operation mode is input

D3 = INPUT();


--D2 is D2 at PIN_C6
--operation mode is input

D2 = INPUT();


--A is A at PIN_B5
--operation mode is input

A = INPUT();


--D5 is D5 at PIN_D6
--operation mode is input

D5 = INPUT();


--D4 is D4 at PIN_B7
--operation mode is input

D4 = INPUT();


--D1 is D1 at PIN_B6
--operation mode is input

D1 = INPUT();


--D0 is D0 at PIN_F6
--operation mode is input

D0 = INPUT();


--F is F at PIN_C5
--operation mode is output

F = OUTPUT(A1L81);



