--A1L4 is o1~66
--operation mode is normal

A1L4 = X1 & (X3 # X2) # !X1 & X3 & X2;


--v1 is v1
--operation mode is normal

v1 = X3 $ X2;


--v2 is v2
--operation mode is normal

v2 = X1 $ X3;


--X1 is X1
--operation mode is input

X1 = INPUT();


--X3 is X3
--operation mode is input

X3 = INPUT();


--X2 is X2
--operation mode is input

X2 = INPUT();


--M is M
--operation mode is output

M = OUTPUT(A1L4);


--a1 is a1
--operation mode is output

a1 = OUTPUT(v1);


--a0 is a0
--operation mode is output

a0 = OUTPUT(v2);


