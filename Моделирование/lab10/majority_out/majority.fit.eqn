--A1L4 is o1~66 at LC_X52_Y1_N4
--operation mode is normal

A1L4 = X2 & (X3 # X1) # !X2 & X3 & X1;


--v1 is v1 at LC_X52_Y1_N5
--operation mode is normal

v1 = X3 $ X2;


--v2 is v2 at LC_X52_Y1_N2
--operation mode is normal

v2 = X3 $ X1;


--X1 is X1 at PIN_V4
--operation mode is input

X1 = INPUT();


--X3 is X3 at PIN_T7
--operation mode is input

X3 = INPUT();


--X2 is X2 at PIN_V3
--operation mode is input

X2 = INPUT();


--M is M at PIN_AA2
--operation mode is output

M = OUTPUT(A1L4);


--a1 is a1 at PIN_W3
--operation mode is output

a1 = OUTPUT(v1);


--a0 is a0 at PIN_AA3
--operation mode is output

a0 = OUTPUT(v2);



