--A1L4 is u2~13 at LC_X5_Y30_N2
--operation mode is normal

A1L4 = x0 $ x1 $ c;


--c is c at PIN_E18
--operation mode is input

c = INPUT();


--x1 is x1 at PIN_C18
--operation mode is input

x1 = INPUT();


--x0 is x0 at PIN_D18
--operation mode is input

x0 = INPUT();


--Ech is Ech at PIN_A18
--operation mode is output

Ech = OUTPUT(A1L4);


--En is En at PIN_B18
--operation mode is output

En = OUTPUT(!A1L4);



