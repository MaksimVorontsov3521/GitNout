# Project-Wide Assignments
# ========================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 5.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "10:51:10  SEPTEMBER 24, 2022"
set_global_assignment -name LAST_QUARTUS_VERSION 5.0
set_global_assignment -name BDF_FILE lab2.bdf
set_global_assignment -name BDF_FILE Risk.bdf
set_global_assignment -name BDF_FILE pluse_gen.bdf
set_global_assignment -name BDF_FILE pluse_former.bdf
set_global_assignment -name BDF_FILE pluse_former_parasite_output.bdf
set_global_assignment -name BDF_FILE pluse_former_fon_and_slice.bdf
set_global_assignment -name BDF_FILE pluse_former_XOR.bdf
set_global_assignment -name VECTOR_WAVEFORM_FILE lab2.vwf

# Timing Assignments
# ==================
set_global_assignment -name IGNORE_CLOCK_SETTINGS ON

# Analysis & Synthesis Assignments
# ================================
set_global_assignment -name FAMILY MAX7000S
set_global_assignment -name ADD_PASS_THROUGH_LOGIC_TO_INFERRED_RAMS OFF
set_global_assignment -name NOT_GATE_PUSH_BACK ON
set_global_assignment -name MAX7000_IGNORE_LCELL_BUFFERS OFF
set_global_assignment -name TOP_LEVEL_ENTITY lab2

# Fitter Assignments
# ==================
set_global_assignment -name DEVICE "EPM7128SLC84-15"
set_global_assignment -name OPTIMIZE_HOLD_TIMING OFF
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1

# Simulator Assignments
# =====================
set_global_assignment -name SIMULATION_MODE TIMING
