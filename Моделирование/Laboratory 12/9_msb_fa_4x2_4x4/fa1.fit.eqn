--A1L6 is X2~13 at LC_X1_Y30_N0
--operation mode is normal

A1L6 = Y $ Cin $ X;


--A1L3 is O1~66 at LC_X1_Y30_N4
--operation mode is normal

A1L3 = Y & (Cin # X) # !Y & Cin & X;


--Cin is Cin at PIN_B21
--operation mode is input

Cin = INPUT();


--Y is Y at PIN_M16
--operation mode is input

Y = INPUT();


--X is X at PIN_C20
--operation mode is input

X = INPUT();


--S is S at PIN_D22
--operation mode is output

S = OUTPUT(A1L6);


--Cout is Cout at PIN_D20
--operation mode is output

Cout = OUTPUT(A1L3);



