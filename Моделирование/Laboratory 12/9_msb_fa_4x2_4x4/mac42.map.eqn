--B9_X1 is fa1:H1|X1
--operation mode is normal

B9_X1 = C0 $ D0 $ (A0 & B0);


--Q00 is Q00
--operation mode is normal

Q00 = A0 & B0;


--B5_X1 is fa1:G1|X1
--operation mode is normal

B5_X1 = C0 $ D0;


--B6L2 is fa1:G2|X2~12
--operation mode is normal

B6L2 = D1 $ C1 $ (C0 & D0);


--B1_X1 is fa1:F1|X1
--operation mode is normal

B1_X1 = A0 & (B1 $ (B0 & A1)) # !A0 & B0 & A1;


--B01L2 is fa1:H2|X2~16
--operation mode is normal

B01L2 = B6L2 $ B1_X1 $ (Q00 & B5_X1);


--B01L1 is fa1:H2|O1~1
--operation mode is normal

B01L1 = B1_X1 & (B6L2 # B5_X1 & Q00) # !B1_X1 & B5_X1 & Q00 & B6L2;


--B6L1 is fa1:G2|O1~1
--operation mode is normal

B6L1 = C1 & (D1 # D0 & C0) # !C1 & D0 & C0 & D1;


--B11_X2 is fa1:H3|X2
--operation mode is normal

B11_X2 = B2L4 $ B01L1 $ C2 $ B6L1;


--Q03 is Q03
--operation mode is normal

Q03 = B0 & A3;


--B3_X2 is fa1:F3|X2
--operation mode is normal

B3_X2 = Q03 $ B2L2 $ (B1 & A2);


--B7_A2 is fa1:G3|A2
--operation mode is normal

B7_A2 = C2 & B6L1;


--B11L1 is fa1:H3|O1~1
--operation mode is normal

B11L1 = B2L4 & (B01L1 # B6L1 $ C2) # !B2L4 & B01L1 & (B6L1 $ C2);


--B21_X2 is fa1:H4|X2
--operation mode is normal

B21_X2 = B3_X2 $ B7_A2 $ B11L1 $ C3;


--B21L1 is fa1:H4|O1~1
--operation mode is normal

B21L1 = B3_X2 & (B11L1 # B7_A2 $ C3) # !B3_X2 & B11L1 & (B7_A2 $ C3);


--B3L1 is fa1:F3|O1~1
--operation mode is normal

B3L1 = Q03 & (B2L2 # A2 & B1) # !Q03 & A2 & B1 & B2L2;


--B4_X2 is fa1:F4|X2
--operation mode is normal

B4_X2 = B3L1 $ (B1 & A3);


--B31_X2 is fa1:H5|X2
--operation mode is normal

B31_X2 = B21L1 $ B4_X2 $ (B7_A2 & C3);


--B31L1 is fa1:H5|O1~1
--operation mode is normal

B31L1 = B4_X2 & (B21L1 # B7_A2 & C3) # !B4_X2 & B7_A2 & C3 & B21L1;


--B41_X2 is fa1:H6|X2
--operation mode is normal

B41_X2 = B31L1 $ (B1 & A3 & B3L1);


--B2L1 is fa1:F2|O1~4
--operation mode is normal

B2L1 = A2 # A0;


--B2L2 is fa1:F2|O1~10
--operation mode is normal

B2L2 = B2L1 & A1 & B0 & B1;


--B2L3 is fa1:F2|X2~41
--operation mode is normal

B2L3 = A2 $ (B1 & A1 & !A0);


--B2L4 is fa1:F2|X2~42
--operation mode is normal

B2L4 = B0 & (B2L3) # !B0 & B1 & (A1);


--A0 is A0
--operation mode is input

A0 = INPUT();


--B0 is B0
--operation mode is input

B0 = INPUT();


--C0 is C0
--operation mode is input

C0 = INPUT();


--D0 is D0
--operation mode is input

D0 = INPUT();


--D1 is D1
--operation mode is input

D1 = INPUT();


--C1 is C1
--operation mode is input

C1 = INPUT();


--A1 is A1
--operation mode is input

A1 = INPUT();


--B1 is B1
--operation mode is input

B1 = INPUT();


--A2 is A2
--operation mode is input

A2 = INPUT();


--C2 is C2
--operation mode is input

C2 = INPUT();


--A3 is A3
--operation mode is input

A3 = INPUT();


--C3 is C3
--operation mode is input

C3 = INPUT();


--P0 is P0
--operation mode is output

P0 = OUTPUT(B9_X1);


--P1 is P1
--operation mode is output

P1 = OUTPUT(B01L2);


--P2 is P2
--operation mode is output

P2 = OUTPUT(B11_X2);


--P3 is P3
--operation mode is output

P3 = OUTPUT(B21_X2);


--P4 is P4
--operation mode is output

P4 = OUTPUT(B31_X2);


--P5 is P5
--operation mode is output

P5 = OUTPUT(B41_X2);


