--A1L6 is X2~13
--operation mode is normal

A1L6 = Cin $ Y $ X;


--A1L3 is O1~66
--operation mode is normal

A1L3 = Cin & (Y # X) # !Cin & Y & X;


--Cin is Cin
--operation mode is input

Cin = INPUT();


--Y is Y
--operation mode is input

Y = INPUT();


--X is X
--operation mode is input

X = INPUT();


--S is S
--operation mode is output

S = OUTPUT(A1L6);


--Cout is Cout
--operation mode is output

Cout = OUTPUT(A1L3);


