--B9_X1 is fa1:H1|X1 at LC_X47_Y30_N2
--operation mode is normal

B9_X1 = D0 $ C0 $ (A0 & B0);


--Q00 is Q00 at LC_X47_Y30_N3
--operation mode is normal

Q00 = B0 & A0;


--B5_X1 is fa1:G1|X1 at LC_X47_Y30_N9
--operation mode is normal

B5_X1 = D0 $ C0;


--B6L2 is fa1:G2|X2~12 at LC_X47_Y30_N8
--operation mode is normal

B6L2 = D1 $ C1 $ (D0 & C0);


--B1_X1 is fa1:F1|X1 at LC_X46_Y30_N6
--operation mode is normal

B1_X1 = A0 & (B1 $ (B0 & A1)) # !A0 & B0 & A1;


--B01L2 is fa1:H2|X2~16 at LC_X47_Y30_N7
--operation mode is normal

B01L2 = B6L2 $ B1_X1 $ (B5_X1 & Q00);


--B01L1 is fa1:H2|O1~1 at LC_X47_Y30_N5
--operation mode is normal

B01L1 = B6L2 & (B1_X1 # B5_X1 & Q00) # !B6L2 & B5_X1 & Q00 & B1_X1;


--B6L1 is fa1:G2|O1~1 at LC_X47_Y30_N0
--operation mode is normal

B6L1 = D1 & (C1 # D0 & C0) # !D1 & D0 & C0 & C1;


--B11_X2 is fa1:H3|X2 at LC_X47_Y30_N6
--operation mode is normal

B11_X2 = C2 $ B6L1 $ B01L1 $ B2L4;


--Q03 is Q03 at LC_X45_Y30_N2
--operation mode is normal

Q03 = B0 & (A3);


--B3_X2 is fa1:F3|X2 at LC_X45_Y30_N0
--operation mode is normal

B3_X2 = Q03 $ B2L2 $ (A2 & B1);


--B7_A2 is fa1:G3|A2 at LC_X47_Y30_N1
--operation mode is normal

B7_A2 = C2 & B6L1;


--B11L1 is fa1:H3|O1~1 at LC_X47_Y30_N4
--operation mode is normal

B11L1 = B01L1 & (B2L4 # C2 $ B6L1) # !B01L1 & B2L4 & (C2 $ B6L1);


--B21_X2 is fa1:H4|X2 at LC_X45_Y30_N1
--operation mode is normal

B21_X2 = B7_A2 $ B11L1 $ C3 $ B3_X2;


--B21L1 is fa1:H4|O1~1 at LC_X45_Y30_N7
--operation mode is normal

B21L1 = B11L1 & (B3_X2 # B7_A2 $ C3) # !B11L1 & B3_X2 & (B7_A2 $ C3);


--B3L1 is fa1:F3|O1~1 at LC_X45_Y30_N3
--operation mode is normal

B3L1 = Q03 & (B2L2 # A2 & B1) # !Q03 & A2 & B1 & B2L2;


--B4_X2 is fa1:F4|X2 at LC_X45_Y30_N5
--operation mode is normal

B4_X2 = B3L1 $ (A3 & B1);


--B31_X2 is fa1:H5|X2 at LC_X45_Y30_N4
--operation mode is normal

B31_X2 = B4_X2 $ B21L1 $ (C3 & B7_A2);


--B31L1 is fa1:H5|O1~1 at LC_X45_Y30_N8
--operation mode is normal

B31L1 = B4_X2 & (B21L1 # B7_A2 & C3) # !B4_X2 & B7_A2 & C3 & B21L1;


--B41_X2 is fa1:H6|X2 at LC_X45_Y30_N9
--operation mode is normal

B41_X2 = B31L1 $ (B3L1 & A3 & B1);


--B2L1 is fa1:F2|O1~4 at LC_X46_Y30_N1
--operation mode is normal

B2L1 = A2 # A0;


--B2L2 is fa1:F2|O1~10 at LC_X45_Y30_N6
--operation mode is normal

B2L2 = B1 & A1 & B0 & B2L1;


--B2L3 is fa1:F2|X2~41 at LC_X46_Y30_N5
--operation mode is normal

B2L3 = A2 $ (!A0 & A1 & B1);


--B2L4 is fa1:F2|X2~42 at LC_X46_Y30_N2
--operation mode is normal

B2L4 = B0 & (B2L3) # !B0 & B1 & (A1);


--A0 is A0 at PIN_D6
--operation mode is input

A0 = INPUT();


--B0 is B0 at PIN_E6
--operation mode is input

B0 = INPUT();


--C0 is C0 at PIN_E5
--operation mode is input

C0 = INPUT();


--D0 is D0 at PIN_B6
--operation mode is input

D0 = INPUT();


--D1 is D1 at PIN_B7
--operation mode is input

D1 = INPUT();


--C1 is C1 at PIN_B5
--operation mode is input

C1 = INPUT();


--A1 is A1 at PIN_A8
--operation mode is input

A1 = INPUT();


--B1 is B1 at PIN_F7
--operation mode is input

B1 = INPUT();


--A2 is A2 at PIN_A6
--operation mode is input

A2 = INPUT();


--C2 is C2 at PIN_A5
--operation mode is input

C2 = INPUT();


--A3 is A3 at PIN_D7
--operation mode is input

A3 = INPUT();


--C3 is C3 at PIN_E7
--operation mode is input

C3 = INPUT();


--P0 is P0 at PIN_C5
--operation mode is output

P0 = OUTPUT(B9_X1);


--P1 is P1 at PIN_C6
--operation mode is output

P1 = OUTPUT(B01L2);


--P2 is P2 at PIN_D5
--operation mode is output

P2 = OUTPUT(B11_X2);


--P3 is P3 at PIN_C7
--operation mode is output

P3 = OUTPUT(B21_X2);


--P4 is P4 at PIN_F6
--operation mode is output

P4 = OUTPUT(B31_X2);


--P5 is P5 at PIN_A7
--operation mode is output

P5 = OUTPUT(B41_X2);



