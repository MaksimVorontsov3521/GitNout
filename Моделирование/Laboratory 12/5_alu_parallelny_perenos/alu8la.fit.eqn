--C2L3 is 74181:U2|45~10 at LC_X52_Y23_N5
--operation mode is normal

C2L3 = A[6] # B[6] & S[0] # !B[6] & (S[1]);


--C2L8 is 74181:U2|52~51 at LC_X52_Y23_N4
