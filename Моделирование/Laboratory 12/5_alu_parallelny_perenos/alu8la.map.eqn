--B[1] is B[1]
--operation mode is input

B[1] = INPUT();


--CN is CN
--operation mode is input

CN = INPUT();


--A[0] is A[0]
--operation mode is input

A[0] = INPUT();


--B[0] is B[0]
--operation mode is input

B[0] = INPUT();


--A[4] is A[4]
--operation mode is input

A[4] = INPUT();


--B[4] is B[4]
--operation mode is input

B[4] = INPUT();


--M is M
--operation mode is input

M = INPUT();


--CN4 is CN4
--operation mode is output

CN4 = OUTPUT(C2L61);


--F[7] is F[7]
--operation mode is output

F[7] = OUTPUT(C2L31);


--F[6] is F[6]
--operation mode is output

F[6] = OUTPUT(C2_82);


