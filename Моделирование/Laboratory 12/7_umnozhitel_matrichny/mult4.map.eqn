--B1L2 is 7483:AD1|2~91
--operation mode is normal

B1L2 = A[1] & A[0];


--B1L3 is 7483:AD1|2~92
--operation mode is normal

B1L3 = B[0] & B[1];


--B1L4 is 7483:AD1|2~93
--operation mode is normal

B1L4 = !B1L2 & !A[2] # !B1L3 # !A[3];


--B1L1 is 7483:AD1|1~103
--operation mode is normal

B1L1 = A[3] & !A[2] & (!A[1] # !A[0]) # !A[3] & (!A[2] # !A[1]);


--B1_45 is 7483:AD1|45
--operation mode is normal

B1_45 = A[3] $ (B1L1 # !B[0]) # !B[1];


--P22 is P22
--operation mode is normal

P22 = B[2] & A[2];


--B1L11 is 7483:AD1|51~45
--operation mode is normal

B1L11 = !A[0] & !A[2];


--B1L9 is 7483:AD1|44~192
--operation mode is normal

B1L9 = A[3] & (B[0] $ (A[2] & B[1])) # !A[3] & A[2] & B[1];


--B1_44 is 7483:AD1|44
--operation mode is normal

B1_44 = B1L9 $ (B1L11 # !B1L3 # !A[1]);


--B1L7 is 7483:AD1|43~103
--operation mode is normal

B1L7 = A[0] & B[0] # !B[1] # !A[1];


--B1_43 is 7483:AD1|43
--operation mode is normal

B1_43 = B1L7 $ (A[2] & B[0]);


--A1L31 is P20~19
--operation mode is normal

A1L31 = B[2] & A[0];


--P21 is P21
--operation mode is normal

P21 = B[2] & A[1];


--B2L1 is 7483:AD2|1~474
--operation mode is normal

B2L1 = B1_44 & !B1_43 & A1L31 & P21 # !B1_44 & (P21 # !B1_43 & A1L31);


--B2L3 is 7483:AD2|2~183
--operation mode is normal

B2L3 = B1L4 & (B2L2 # !B[2] # !A[3]) # !B1L4 & B2L2 & (!B[2] # !A[3]);


--B2_45 is 7483:AD2|45
--operation mode is normal

B2_45 = B1L4 $ B2L2 $ (!B[2] # !A[3]);


--A1L61 is P30~19
--operation mode is normal

A1L61 = B[3] & A[0];


--B2_43 is 7483:AD2|43
--operation mode is normal

B2_43 = P21 $ B1_44 $ (B1_43 # !A1L31);


--P31 is P31
--operation mode is normal

P31 = B[3] & A[1];


--B2L9 is 7483:AD2|51~227
--operation mode is normal

B2L9 = B1_44 & (B1_43 # !P21 # !A1L31) # !B1_44 & !P21 & (B1_43 # !A1L31);


--B3L1 is 7483:AD3|1~602
--operation mode is normal

B3L1 = A1L61 & !B2_43 & (!B2_44 # !P31) # !A1L61 & (!B2_44 # !P31);


--B2L7 is 7483:AD2|44~448
--operation mode is normal

B2L7 = !P31 & (P22 $ B1_45 $ !B2L9);


--P32 is P32
--operation mode is normal

P32 = B[3] & A[2];


--B3L2 is 7483:AD3|1~603
--operation mode is normal

B3L2 = B2_45 & (B3L1 # B2L7 # !P32) # !B2_45 & !P32 & (B3L1 # B2L7);


--B3L3 is 7483:AD3|2~105
--operation mode is normal

B3L3 = B2L3 & (B3L2 # !B[3] # !A[3]) # !B2L3 & B3L2 & (!B[3] # !A[3]);


--B3_45 is 7483:AD3|45
--operation mode is normal

B3_45 = B2L3 $ B3L2 $ (!B[3] # !A[3]);


--B3L8 is 7483:AD3|51~139
--operation mode is normal

B3L8 = P31 & !B2_44 & (!B2_43 # !A1L61) # !P31 & (!B2_44 # !B2_43 # !A1L61);


--B3_43 is 7483:AD3|43
--operation mode is normal

B3_43 = P31 $ B2_44 $ (!B2_43 # !A1L61);


--B2L4 is 7483:AD2|27~51
--operation mode is normal

B2L4 = A1L31 $ B1L7 $ (A[2] & B[0]);


--B1L5 is 7483:AD1|27~27
--operation mode is normal

B1L5 = A[1] & (B[0] $ (A[0] & B[1])) # !A[1] & A[0] & B[1];


--P00 is P00
--operation mode is normal

P00 = A[0] & B[0];


--B2L2 is 7483:AD2|1~475
--operation mode is normal

B2L2 = B1_45 & (!B2L1 # !A[2] # !B[2]) # !B1_45 & !B2L1 & (!A[2] # !B[2]);


--B2_44 is 7483:AD2|44
--operation mode is normal

B2_44 = B1_45 $ B2L9 $ (B[2] & A[2]);


--B3_44 is 7483:AD3|44
--operation mode is normal

B3_44 = B2_45 $ B3L8 $ (B[3] & A[2]);


--B3L4 is 7483:AD3|27~3
--operation mode is normal

B3L4 = B2_43 $ (B[3] & A[0]);


--A[1] is A[1]
--operation mode is input

A[1] = INPUT();


--A[0] is A[0]
--operation mode is input

A[0] = INPUT();


--A[2] is A[2]
--operation mode is input

A[2] = INPUT();


--A[3] is A[3]
--operation mode is input

A[3] = INPUT();


--B[0] is B[0]
--operation mode is input

B[0] = INPUT();


--B[1] is B[1]
--operation mode is input

B[1] = INPUT();


--B[2] is B[2]
--operation mode is input

B[2] = INPUT();


--B[3] is B[3]
--operation mode is input

B[3] = INPUT();


--P[7] is P[7]
--operation mode is output

P[7] = OUTPUT(!B3L3);


--P[6] is P[6]
--operation mode is output

P[6] = OUTPUT(!B3_45);


--P[5] is P[5]
--operation mode is output

P[5] = OUTPUT(B3_44);


--P[4] is P[4]
--operation mode is output

P[4] = OUTPUT(!B3_43);


--P[3] is P[3]
--operation mode is output

P[3] = OUTPUT(B3L4);


--P[2] is P[2]
--operation mode is output

P[2] = OUTPUT(!B2L4);


--P[1] is P[1]
--operation mode is output

P[1] = OUTPUT(B1L5);


--P[0] is P[0]
--operation mode is output

P[0] = OUTPUT(P00);


