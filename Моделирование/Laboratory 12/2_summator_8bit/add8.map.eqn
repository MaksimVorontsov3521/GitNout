--A1L8 is A[4]~102
--operation mode is normal

A1L8 = !A[4] & !B[4];


--B2L1 is 7483:U2|1~105
--operation mode is normal

B2L1 = !B[4] # !A[4];


--B1L7 is 7483:U1|51~214
--operation mode is normal

B1L7 = B[0] & !CI & !A[0] # !B[0] & (!A[0] # !CI);


--B1L1 is 7483:U1|1~212
--operation mode is normal

B1L1 = B1L7 & (!A[1] # !B[1]);


--A1L4 is A[1]~103
--operation mode is normal

A1L4 = !B[1] & !A[1];


--B1L2 is 7483:U1|1~213
--operation mode is normal

B1L2 = B[2] & !A[2] & (B1L1 # A1L4) # !B[2] & (B1L1 # A1L4 # !A[2]);


--B2L2 is 7483:U2|1~106
--operation mode is normal

B2L2 = B2L1 & (B1L2 & (!A[3] # !B[3]) # !B1L2 & !B[3] & !A[3]);


--B2L3 is 7483:U2|1~107
--operation mode is normal

B2L3 = B[5] & (A[5] # !A1L8 & !B2L2) # !B[5] & !A1L8 & !B2L2 & A[5];


--B2L4 is 7483:U2|1~108
--operation mode is normal

B2L4 = B[6] & !A[6] & !B2L3 # !B[6] & (!B2L3 # !A[6]);


--B2L5 is 7483:U2|2~69
--operation mode is normal

B2L5 = B2L4 & (!A[7] # !B[7]) # !B2L4 & (!B[7] & !A[7]);


--B2_45 is 7483:U2|45
--operation mode is normal

B2_45 = B[7] $ A[7] $ B2L4;


--B2L11 is 7483:U2|51~59
--operation mode is normal

B2L11 = B[5] & !A[5] & (A1L8 # B2L2) # !B[5] & (A1L8 # B2L2 # !A[5]);


--B2_44 is 7483:U2|44
--operation mode is normal

B2_44 = B[6] $ A[6] $ B2L11;


--B2_43 is 7483:U2|43
--operation mode is normal

B2_43 = B[5] $ A[5] $ (A1L8 # B2L2);


--B2L7 is 7483:U2|42~8
--operation mode is normal

B2L7 = A[4] $ B[4];


--B2_42 is 7483:U2|42
--operation mode is normal

B2_42 = B2L7 $ (B1L2 & B[3] & A[3] # !B1L2 & (B[3] # A[3]));


--B1_45 is 7483:U1|45
--operation mode is normal

B1_45 = B[3] $ A[3] $ B1L2;


--B1_44 is 7483:U1|44
--operation mode is normal

B1_44 = B[2] $ A[2] $ (B1L1 # A1L4);


--B1_43 is 7483:U1|43
--operation mode is normal

B1_43 = B1L7 $ B[1] $ A[1];


--B1L3 is 7483:U1|42~13
--operation mode is normal

B1L3 = B[0] $ CI $ A[0];


--B[6] is B[6]
--operation mode is input

B[6] = INPUT();


--A[6] is A[6]
--operation mode is input

A[6] = INPUT();


--A[4] is A[4]
--operation mode is input

A[4] = INPUT();


--B[4] is B[4]
--operation mode is input

B[4] = INPUT();


--B[0] is B[0]
--operation mode is input

B[0] = INPUT();


--CI is CI
--operation mode is input

CI = INPUT();


--A[0] is A[0]
--operation mode is input

A[0] = INPUT();


--B[1] is B[1]
--operation mode is input

B[1] = INPUT();


--A[1] is A[1]
--operation mode is input

A[1] = INPUT();


--B[2] is B[2]
--operation mode is input

B[2] = INPUT();


--A[2] is A[2]
--operation mode is input

A[2] = INPUT();


--B[3] is B[3]
--operation mode is input

B[3] = INPUT();


--A[3] is A[3]
--operation mode is input

A[3] = INPUT();


--B[5] is B[5]
--operation mode is input

B[5] = INPUT();


--A[5] is A[5]
--operation mode is input

A[5] = INPUT();


--B[7] is B[7]
--operation mode is input

B[7] = INPUT();


--A[7] is A[7]
--operation mode is input

A[7] = INPUT();


--CO is CO
--operation mode is output

CO = OUTPUT(!B2L5);


--S[7] is S[7]
--operation mode is output

S[7] = OUTPUT(!B2_45);


--S[6] is S[6]
--operation mode is output

S[6] = OUTPUT(!B2_44);


--S[5] is S[5]
--operation mode is output

S[5] = OUTPUT(!B2_43);


--S[4] is S[4]
--operation mode is output

S[4] = OUTPUT(B2_42);


--S[3] is S[3]
--operation mode is output

S[3] = OUTPUT(!B1_45);


--S[2] is S[2]
--operation mode is output

S[2] = OUTPUT(!B1_44);


--S[1] is S[1]
--operation mode is output

S[1] = OUTPUT(!B1_43);


--S[0] is S[0]
--operation mode is output

S[0] = OUTPUT(B1L3);


