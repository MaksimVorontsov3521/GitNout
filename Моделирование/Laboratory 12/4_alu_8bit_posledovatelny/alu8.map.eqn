--B1L9 is 74181:U1|66~19
--operation mode is normal

B1L9 = CN & (!B1L4);


--B1L1 is 74181:U1|43~16
--operation mode is normal

B1L1 = A[0] # B[0] & S[0] # !B[0] & (S[1]);


--B1L5 is 74181:U1|47~51
--operation mode is normal

B1L5 = A[1] & (B[1] & S[3] # !B[1] & (S[2]));


--B1L41 is 74181:U1|78~134
--operation mode is normal

B1L41 = !B1L6 & !B1L5 & (B1L9 # !B1L1);


--B1L7 is 74181:U1|51~17
--operation mode is normal

B1L7 = A[3] # B[3] & S[0] # !B[3] & (S[1]);


--B1L51 is 74181:U1|78~135
--operation mode is normal

B1L51 = B1L31 # B1L41 & !B1L8 # !B1L7;


--B2L5 is 74181:U2|47~51
--operation mode is normal

B2L5 = A[5] & (B[5] & S[3] # !B[5] & (S[2]));


--B2L4 is 74181:U2|46~51
--operation mode is normal

B2L4 = A[4] & (B[4] & S[3] # !B[4] & (S[2]));


--B2L01 is 74181:U2|73~15
