--B2L3 is 74181:U2|45~10
--operation mode is normal

B2L3 = A[6] # B[6] & S[0] # !B[6] & (S[1]);


--B2L8 is 74181:U2|52~51
--operation mode is normal

B2L8 = A[7] & (B[7] & S[3] # !B[7] & (S[2]));


--B2L7 is 74181:U2|51~17
--operation mode is normal

