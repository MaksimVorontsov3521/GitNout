--operation mode is normal

B2L9 = !B2L5 & !B2L1;


--B2L51 is 74181:U2|78~29
--operation mode is normal

B2L51 = B2L6 # B2L2 & !B2L01 & !B2L9;


--B2L61 is 74181:U2|78~30
--operation mode is normal

B2L61 = !B2L8 & (!B2L51 # !B2L3) # !B2L7;


--B2L21 is 74181:U2|77~171
--operation mode is normal

B2L21 = B2L3 & (B2L6 # B2L41);


--B2L31 is 74181:U2|77~172
--operation mode is normal

B2L31 = B2L8 $ B2L7 $ (M # B2L21);


--B2_75 is 74181:U2|75
--operation mode is normal

B2_75 = !M & (B2L01 # B2L9 # !B2L2);


--B2_82 is 74181:U2|82
--operation mode is normal

