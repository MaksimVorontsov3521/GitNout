--B1L21 is 74181:U1|77~183
--operation mode is normal

B1L21 = B1L8 $ B1L7 $ (M # B1L11);


--B1L01 is 74181:U1|75~338
--operation mode is normal

B1L01 = !B1L5 & (B1L9 # !B1L1) # !B1L2;


--B1_82 is 74181:U1|82
--operation mode is normal

B1_82 = B1L6 $ B1L3 $ (M # !B1L01);


--B1L81 is 74181:U1|81~118
--operation mode is normal

B1L81 = B1L5 $ B1L2;


--B1_81 is 74181:U1|81
--operation mode is normal

B1_81 = B1L81 $ (M # !B1L9 & B1L1);


--B1L61 is 74181:U1|80~84
--operation mode is normal

B1L61 = B1L4 $ B1L1 $ (CN & !M);


--B2L41 is 74181:U2|77~173
--operation mode is normal

B2L41 = !B2L01 & B2L2 & (B2L5 # B2L1);


