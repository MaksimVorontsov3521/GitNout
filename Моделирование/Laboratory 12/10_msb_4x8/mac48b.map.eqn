--B1_Q00 is mac42:S0|Q00
--operation mode is normal

B1_Q00 = A0 & B0;


--C1_X1 is mac42:S0|fa1:F1|X1
--operation mode is normal

C1_X1 = A0 & (B1 $ (B0 & A1)) # !A0 & B0 & A1;


--B2_Q00 is mac42:S1|Q00
--operation mode is normal

B2_Q00 = A0 & B2;


--C51_X1 is mac42:S1|fa1:F1|X1
--operation mode is normal

C51_X1 = A0 & (B3 $ (A1 & B2)) # !A0 & A1 & B2;


--B1_Q03 is mac42:S0|Q03
--operation mode is normal

B1_Q03 = B0 & A3;


--C3_X2 is mac42:S0|fa1:F3|X2
--operation mode is normal

C3_X2 = B1_Q03 $ C2L2 $ (B1 & A2);


--C42_X2 is mac42:S1|fa1:H2|X2
--operation mode is normal

C42_X2 = C51_X1 $ C3_X2 $ (B2_Q00 & C2L4);


--B3_Q00 is mac42:S2|Q00
--operation mode is normal

B3_Q00 = A0 & B4;


--B1_Q13 is mac42:S0|Q13
--operation mode is normal

B1_Q13 = B1 & A3;


--C42L1 is mac42:S1|fa1:H2|O1~1
--operation mode is normal

C42L1 = C51_X1 & (C3_X2 # C2L4 & B2_Q00) # !C51_X1 & C2L4 & B2_Q00 & C3_X2;


--C3L1 is mac42:S0|fa1:F3|O1~1
--operation mode is normal

C3L1 = B1_Q03 & (C2L2 # A2 & B1) # !B1_Q03 & A2 & B1 & C2L2;


--C52_X2 is mac42:S1|fa1:H3|X2
--operation mode is normal

C52_X2 = C61L3 $ B1_Q13 $ C42L1 $ C3L1;


--B2_Q03 is mac42:S1|Q03
--operation mode is normal

B2_Q03 = B2 & A3;


--C71_X2 is mac42:S1|fa1:F3|X2
--operation mode is normal

C71_X2 = B2_Q03 $ C61L1 $ (A2 & B3);


--C52L1 is mac42:S1|fa1:H3|O1~1
--operation mode is normal

C52L1 = C61L3 & (C42L1 # C3L1 $ B1_Q13) # !C61L3 & C42L1 & (C3L1 $ B1_Q13);


--C62_X2 is mac42:S1|fa1:H4|X2
--operation mode is normal

C62_X2 = C71_X2 $ C52L1 $ (B1_Q13 & C3L1);


--C92_X1 is mac42:S2|fa1:F1|X1
--operation mode is normal

C92_X1 = A0 & (B5 $ (A1 & B4)) # !A0 & A1 & B4;


--C83_X2 is mac42:S2|fa1:H2|X2
--operation mode is normal

C83_X2 = C62_X2 $ C92_X1 $ (B3_Q00 & C52_X2);


--B4_Q00 is mac42:S3|Q00
--operation mode is normal

B4_Q00 = A0 & B6;


--C71L1 is mac42:S1|fa1:F3|O1~3
--operation mode is normal

C71L1 = B2_Q03 & (C61L1 # B3 & A2) # !B2_Q03 & B3 & A2 & C61L1;


--C81_X2 is mac42:S1|fa1:F4|X2
--operation mode is normal

C81_X2 = C71L1 $ (B3 & A3);


--C83L1 is mac42:S2|fa1:H2|O1~1
--operation mode is normal

C83L1 = C92_X1 & (C62_X2 # C52_X2 & B3_Q00) # !C92_X1 & C52_X2 & B3_Q00 & C62_X2;


--C62L1 is mac42:S1|fa1:H4|O1~1
--operation mode is normal

C62L1 = C71_X2 & (C52L1 # C3L1 & B1_Q13) # !C71_X2 & C3L1 & B1_Q13 & C52L1;


--C93L2 is mac42:S2|fa1:H3|X2~19
--operation mode is normal

C93L2 = C03L3 $ C81_X2 $ C83L1 $ C62L1;


--B3_Q03 is mac42:S2|Q03
--operation mode is normal

B3_Q03 = A3 & B4;


--C13_X2 is mac42:S2|fa1:F3|X2
--operation mode is normal

C13_X2 = B3_Q03 $ C03L1 $ (A2 & B5);


--C72_A2 is mac42:S1|fa1:H5|A2
--operation mode is normal

C72_A2 = C62L1 & (C71L1 $ (B3 & A3));


--C81_A2 is mac42:S1|fa1:F4|A2
--operation mode is normal

C81_A2 = B3 & A3 & C71L1;


--C93L1 is mac42:S2|fa1:H3|O1~1
--operation mode is normal

C93L1 = C03L3 & (C83L1 # C62L1 $ C81_X2) # !C03L3 & C83L1 & (C62L1 $ C81_X2);


--C04L2 is mac42:S2|fa1:H4|X2~17
--operation mode is normal

C04L2 = C13_X2 $ C72_A2 $ C81_A2 $ C93L1;


--C34_X1 is mac42:S3|fa1:F1|X1
--operation mode is normal

C34_X1 = A0 & (B7 $ (A1 & B6)) # !A0 & A1 & B6;


--C25L2 is mac42:S3|fa1:H2|X2~14
--operation mode is normal

C25L2 = C04L2 $ C34_X1 $ (B4_Q00 & C93L2);


--C13L1 is mac42:S2|fa1:F3|O1~3
--operation mode is normal

C13L1 = B3_Q03 & (C03L1 # B5 & A2) # !B3_Q03 & B5 & A2 & C03L1;


--C23_X2 is mac42:S2|fa1:F4|X2
--operation mode is normal

C23_X2 = C13L1 $ (A3 & B5);


--C25L1 is mac42:S3|fa1:H2|O1~1
--operation mode is normal

C25L1 = C34_X1 & (C04L2 # C93L2 & B4_Q00) # !C34_X1 & C93L2 & B4_Q00 & C04L2;


--C04L1 is mac42:S2|fa1:H4|O1~1
--operation mode is normal

C04L1 = C13_X2 & (C93L1 # C72_A2 $ C81_A2) # !C13_X2 & C93L1 & (C72_A2 $ C81_A2);


--C35L2 is mac42:S3|fa1:H3|X2~18
--operation mode is normal

C35L2 = C44L3 $ C23_X2 $ C25L1 $ C04L1;


--B4_Q03 is mac42:S3|Q03
--operation mode is normal

B4_Q03 = A3 & B6;


--C54_X2 is mac42:S3|fa1:F3|X2
--operation mode is normal

C54_X2 = B4_Q03 $ C44L1 $ (A2 & B7);


--C14_A2 is mac42:S2|fa1:H5|A2
--operation mode is normal

C14_A2 = C04L1 & (C13L1 $ (A3 & B5));


--C23_A2 is mac42:S2|fa1:F4|A2
--operation mode is normal

C23_A2 = A3 & B5 & C13L1;


--C35L1 is mac42:S3|fa1:H3|O1~1
--operation mode is normal

C35L1 = C44L3 & (C25L1 # C04L1 $ C23_X2) # !C44L3 & C25L1 & (C04L1 $ C23_X2);


--C45L2 is mac42:S3|fa1:H4|X2~16
--operation mode is normal

C45L2 = C54_X2 $ C14_A2 $ C23_A2 $ C35L1;


--C54L1 is mac42:S3|fa1:F3|O1~1
--operation mode is normal

C54L1 = B4_Q03 & (C44L1 # B7 & A2) # !B4_Q03 & B7 & A2 & C44L1;


--C45L1 is mac42:S3|fa1:H4|O1~1
--operation mode is normal

C45L1 = C54_X2 & (C35L1 # C14_A2 $ C23_A2) # !C54_X2 & C35L1 & (C14_A2 $ C23_A2);


--C55_X2 is mac42:S3|fa1:H5|X2
--operation mode is normal

C55_X2 = C54L1 $ C45L1 $ (A3 & B7);


--C65_X2 is mac42:S3|fa1:H6|X2
--operation mode is normal

C65_X2 = C54L1 & (C45L1 # A3 & B7) # !C54L1 & C45L1 & A3 & B7;


--C32_X1 is mac42:S1|fa1:H1|X1
--operation mode is normal

C32_X1 = C2L4 $ (A0 & B2);


--C73_X1 is mac42:S2|fa1:H1|X1
--operation mode is normal

C73_X1 = C52_X2 $ (A0 & B4);


--C15_X1 is mac42:S3|fa1:H1|X1
--operation mode is normal

C15_X1 = C93L2 $ (A0 & B6);


--C2L1 is mac42:S0|fa1:F2|O1~4
--operation mode is normal

C2L1 = A2 # A0;


--C2L2 is mac42:S0|fa1:F2|O1~10
--operation mode is normal

C2L2 = C2L1 & A1 & B0 & B1;


--C61L1 is mac42:S1|fa1:F2|O1~10
--operation mode is normal

C61L1 = C2L1 & B2 & A1 & B3;


--C03L1 is mac42:S2|fa1:F2|O1~10
--operation mode is normal

C03L1 = C2L1 & B4 & A1 & B5;


--C44L1 is mac42:S3|fa1:F2|O1~10
--operation mode is normal

C44L1 = C2L1 & B6 & A1 & B7;


--C44L2 is mac42:S3|fa1:F2|X2~41
--operation mode is normal

C44L2 = B7 & A1 & (!A0 # !B6) # !B7 & B6;


--C44L3 is mac42:S3|fa1:F2|X2~42
--operation mode is normal

C44L3 = B7 & (C44L2 $ (B6 & A2)) # !B7 & C44L2 & B6 & A2;


--C03L2 is mac42:S2|fa1:F2|X2~41
--operation mode is normal

C03L2 = B5 & A1 & (!A0 # !B4) # !B5 & B4;


--C03L3 is mac42:S2|fa1:F2|X2~42
--operation mode is normal

C03L3 = B5 & (C03L2 $ (B4 & A2)) # !B5 & C03L2 & B4 & A2;


--C61L2 is mac42:S1|fa1:F2|X2~41
--operation mode is normal

C61L2 = B3 & A1 & (!A0 # !B2) # !B3 & B2;


--C61L3 is mac42:S1|fa1:F2|X2~42
--operation mode is normal

C61L3 = B3 & (C61L2 $ (B2 & A2)) # !B3 & C61L2 & B2 & A2;


--C2L3 is mac42:S0|fa1:F2|X2~41
--operation mode is normal

C2L3 = A2 $ (B1 & A1 & !A0);


--C2L4 is mac42:S0|fa1:F2|X2~42
--operation mode is normal

C2L4 = B0 & (C2L3) # !B0 & B1 & (A1);


--A0 is A0
--operation mode is input

A0 = INPUT();


--B0 is B0
--operation mode is input

B0 = INPUT();


--A1 is A1
--operation mode is input

A1 = INPUT();


--B1 is B1
--operation mode is input

B1 = INPUT();


--B2 is B2
--operation mode is input

B2 = INPUT();


--A2 is A2
--operation mode is input

A2 = INPUT();


--B3 is B3
--operation mode is input

B3 = INPUT();


--A3 is A3
--operation mode is input

A3 = INPUT();


--B4 is B4
--operation mode is input

B4 = INPUT();


--B5 is B5
--operation mode is input

B5 = INPUT();


--B6 is B6
--operation mode is input

B6 = INPUT();


--B7 is B7
--operation mode is input

B7 = INPUT();


--P0 is P0
--operation mode is output

P0 = OUTPUT(B1_Q00);


--P1 is P1
--operation mode is output

P1 = OUTPUT(C1_X1);


--P2 is P2
--operation mode is output

P2 = OUTPUT(C32_X1);


--P3 is P3
--operation mode is output

P3 = OUTPUT(C42_X2);


--P4 is P4
--operation mode is output

P4 = OUTPUT(C73_X1);


--P5 is P5
--operation mode is output

P5 = OUTPUT(C83_X2);


--P6 is P6
--operation mode is output

P6 = OUTPUT(C15_X1);


--P7 is P7
--operation mode is output

P7 = OUTPUT(C25L2);


--P8 is P8
--operation mode is output

P8 = OUTPUT(C35L2);


--P9 is P9
--operation mode is output

P9 = OUTPUT(C45L2);


--P10 is P10
--operation mode is output

P10 = OUTPUT(C55_X2);


--P11 is P11
--operation mode is output

P11 = OUTPUT(C65_X2);


