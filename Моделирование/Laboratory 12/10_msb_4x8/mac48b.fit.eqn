--B1_Q00 is mac42:S0|Q00 at LC_X1_Y6_N0
--operation mode is normal

B1_Q00 = A0 & (B0);


--C1_X1 is mac42:S0|fa1:F1|X1 at LC_X2_Y4_N9
--operation mode is normal

C1_X1 = A1 & (B0 $ (A0 & B1)) # !A1 & (A0 & B1);


--B2_Q00 is mac42:S1|Q00 at LC_X2_Y4_N7
--operation mode is normal

B2_Q00 = A0 & B2;


--C51_X1 is mac42:S1|fa1:F1|X1 at LC_X1_Y4_N0
--operation mode is normal

C51_X1 = A1 & (B2 $ (B3 & A0)) # !A1 & (B3 & A0);


--B1_Q03 is mac42:S0|Q03 at LC_X2_Y4_N6
--operation mode is normal

B1_Q03 = A3 & (B0);


--C3_X2 is mac42:S0|fa1:F3|X2 at LC_X2_Y4_N0
--operation mode is normal

C3_X2 = B1_Q03 $ C2L2 $ (B1 & A2);


--C42_X2 is mac42:S1|fa1:H2|X2 at LC_X2_Y4_N2
--operation mode is normal

C42_X2 = C3_X2 $ C51_X1 $ (C2L4 & B2_Q00);


--B3_Q00 is mac42:S2|Q00 at LC_X2_Y3_N7
--operation mode is normal

B3_Q00 = A0 & B4;


--B1_Q13 is mac42:S0|Q13 at LC_X2_Y2_N2
--operation mode is normal

B1_Q13 = A3 & (B1);


--C42L1 is mac42:S1|fa1:H2|O1~1 at LC_X2_Y4_N1
--operation mode is normal

C42L1 = C3_X2 & (C51_X1 # C2L4 & B2_Q00) # !C3_X2 & C2L4 & B2_Q00 & C51_X1;


--C3L1 is mac42:S0|fa1:F3|O1~1 at LC_X2_Y4_N8
--operation mode is normal

C3L1 = B1_Q03 & (C2L2 # B1 & A2) # !B1_Q03 & B1 & A2 & C2L2;


--C52_X2 is mac42:S1|fa1:H3|X2 at LC_X2_Y3_N0
--operation mode is normal

C52_X2 = C42L1 $ C61L3 $ C3L1 $ B1_Q13;


--B2_Q03 is mac42:S1|Q03 at LC_X1_Y4_N3
--operation mode is normal

B2_Q03 = B2 & (A3);


--C71_X2 is mac42:S1|fa1:F3|X2 at LC_X1_Y4_N7
--operation mode is normal

C71_X2 = B2_Q03 $ C61L1 $ (A2 & B3);


--C52L1 is mac42:S1|fa1:H3|O1~1 at LC_X2_Y3_N6
--operation mode is normal

C52L1 = C42L1 & (C61L3 # C3L1 $ B1_Q13) # !C42L1 & C61L3 & (C3L1 $ B1_Q13);


--C62_X2 is mac42:S1|fa1:H4|X2 at LC_X2_Y3_N3
--operation mode is normal

C62_X2 = C71_X2 $ C52L1 $ (C3L1 & B1_Q13);


--C92_X1 is mac42:S2|fa1:F1|X1 at LC_X2_Y3_N8
--operation mode is normal

C92_X1 = A1 & (B4 $ (B5 & A0)) # !A1 & B5 & A0;


--C83_X2 is mac42:S2|fa1:H2|X2 at LC_X2_Y3_N1
--operation mode is normal

C83_X2 = C62_X2 $ C92_X1 $ (C52_X2 & B3_Q00);


--B4_Q00 is mac42:S3|Q00 at LC_X1_Y2_N7
--operation mode is normal

B4_Q00 = A0 & B6;


--C71L1 is mac42:S1|fa1:F3|O1~3 at LC_X1_Y4_N4
--operation mode is normal

C71L1 = C61L1 & (B2_Q03 # B3 & A2) # !C61L1 & B3 & A2 & B2_Q03;


--C81_X2 is mac42:S1|fa1:F4|X2 at LC_X1_Y4_N9
--operation mode is normal

C81_X2 = C71L1 $ (A3 & B3);


--C83L1 is mac42:S2|fa1:H2|O1~1 at LC_X2_Y3_N9
--operation mode is normal

C83L1 = C62_X2 & (C92_X1 # C52_X2 & B3_Q00) # !C62_X2 & C52_X2 & B3_Q00 & C92_X1;


--C62L1 is mac42:S1|fa1:H4|O1~1 at LC_X2_Y3_N2
--operation mode is normal

C62L1 = C71_X2 & (C52L1 # C3L1 & B1_Q13) # !C71_X2 & C52L1 & C3L1 & B1_Q13;


--C93L2 is mac42:S2|fa1:H3|X2~19 at LC_X1_Y2_N9
--operation mode is normal

C93L2 = C83L1 $ C62L1 $ C81_X2 $ C03L3;


--B3_Q03 is mac42:S2|Q03 at LC_X1_Y3_N4
--operation mode is normal

B3_Q03 = A3 & B4;


--C13_X2 is mac42:S2|fa1:F3|X2 at LC_X1_Y3_N2
--operation mode is normal

C13_X2 = B3_Q03 $ C03L1 $ (B5 & A2);


--C72_A2 is mac42:S1|fa1:H5|A2 at LC_X1_Y3_N3
--operation mode is normal

C72_A2 = C62L1 & (C71L1 $ (A3 & B3));


--C81_A2 is mac42:S1|fa1:F4|A2 at LC_X1_Y3_N9
--operation mode is normal

C81_A2 = A3 & C71L1 & B3;


--C93L1 is mac42:S2|fa1:H3|O1~1 at LC_X1_Y3_N8
--operation mode is normal

C93L1 = C03L3 & (C83L1 # C81_X2 $ C62L1) # !C03L3 & C83L1 & (C81_X2 $ C62L1);


--C04L2 is mac42:S2|fa1:H4|X2~17 at LC_X1_Y3_N1
--operation mode is normal

C04L2 = C93L1 $ C81_A2 $ C72_A2 $ C13_X2;


--C34_X1 is mac42:S3|fa1:F1|X1 at LC_X1_Y2_N8
--operation mode is normal

C34_X1 = B6 & (A1 $ (A0 & B7)) # !B6 & (A0 & B7);


--C25L2 is mac42:S3|fa1:H2|X2~14 at LC_X1_Y2_N6
--operation mode is normal

C25L2 = C34_X1 $ C04L2 $ (C93L2 & B4_Q00);


--C13L1 is mac42:S2|fa1:F3|O1~3 at LC_X1_Y3_N6
--operation mode is normal

C13L1 = B3_Q03 & (C03L1 # B5 & A2) # !B3_Q03 & B5 & A2 & C03L1;


--C23_X2 is mac42:S2|fa1:F4|X2 at LC_X2_Y2_N4
--operation mode is normal

C23_X2 = C13L1 $ (A3 & B5);


--C25L1 is mac42:S3|fa1:H2|O1~1 at LC_X1_Y2_N1
--operation mode is normal

C25L1 = C34_X1 & (C04L2 # C93L2 & B4_Q00) # !C34_X1 & C93L2 & B4_Q00 & C04L2;


--C04L1 is mac42:S2|fa1:H4|O1~1 at LC_X1_Y3_N0
--operation mode is normal

C04L1 = C93L1 & (C13_X2 # C81_A2 $ C72_A2) # !C93L1 & C13_X2 & (C81_A2 $ C72_A2);


--C35L2 is mac42:S3|fa1:H3|X2~18 at LC_X1_Y2_N4
--operation mode is normal

C35L2 = C44L3 $ C25L1 $ C23_X2 $ C04L1;


--B4_Q03 is mac42:S3|Q03 at LC_X1_Y1_N0
--operation mode is normal

B4_Q03 = A3 & (B6);


--C54_X2 is mac42:S3|fa1:F3|X2 at LC_X1_Y1_N5
--operation mode is normal

C54_X2 = B4_Q03 $ C44L1 $ (A2 & B7);


--C14_A2 is mac42:S2|fa1:H5|A2 at LC_X1_Y1_N7
--operation mode is normal

C14_A2 = C04L1 & (C13L1 $ (A3 & B5));


--C23_A2 is mac42:S2|fa1:F4|A2 at LC_X1_Y1_N8
--operation mode is normal

C23_A2 = A3 & (B5 & C13L1);


--C35L1 is mac42:S3|fa1:H3|O1~1 at LC_X1_Y2_N5
--operation mode is normal

C35L1 = C44L3 & (C25L1 # C23_X2 $ C04L1) # !C44L3 & C25L1 & (C23_X2 $ C04L1);


--C45L2 is mac42:S3|fa1:H4|X2~16 at LC_X1_Y1_N1
--operation mode is normal

C45L2 = C14_A2 $ C54_X2 $ C35L1 $ C23_A2;


--C54L1 is mac42:S3|fa1:F3|O1~1 at LC_X1_Y1_N4
--operation mode is normal

C54L1 = B4_Q03 & (C44L1 # B7 & A2) # !B4_Q03 & B7 & A2 & C44L1;


--C45L1 is mac42:S3|fa1:H4|O1~1 at LC_X1_Y1_N2
--operation mode is normal

C45L1 = C54_X2 & (C35L1 # C14_A2 $ C23_A2) # !C54_X2 & C35L1 & (C14_A2 $ C23_A2);


--C55_X2 is mac42:S3|fa1:H5|X2 at LC_X1_Y1_N9
--operation mode is normal

C55_X2 = C54L1 $ C45L1 $ (A3 & B7);


--C65_X2 is mac42:S3|fa1:H6|X2 at LC_X1_Y1_N6
--operation mode is normal

C65_X2 = C54L1 & (C45L1 # A3 & B7) # !C54L1 & A3 & B7 & C45L1;


--C32_X1 is mac42:S1|fa1:H1|X1 at LC_X2_Y4_N4
--operation mode is normal

C32_X1 = C2L4 $ (B2 & A0);


--C73_X1 is mac42:S2|fa1:H1|X1 at LC_X2_Y3_N4
--operation mode is normal

C73_X1 = C52_X2 $ (B4 & A0);


--C15_X1 is mac42:S3|fa1:H1|X1 at LC_X1_Y2_N0
--operation mode is normal

C15_X1 = C93L2 $ (B6 & A0);


--C2L1 is mac42:S0|fa1:F2|O1~4 at LC_X1_Y4_N8
--operation mode is normal

C2L1 = A2 # A0;


--C2L2 is mac42:S0|fa1:F2|O1~10 at LC_X1_Y4_N6
--operation mode is normal

C2L2 = B0 & B1 & A1 & C2L1;


--C61L1 is mac42:S1|fa1:F2|O1~10 at LC_X1_Y4_N5
--operation mode is normal

C61L1 = B3 & B2 & A1 & C2L1;


--C03L1 is mac42:S2|fa1:F2|O1~10 at LC_X1_Y3_N5
--operation mode is normal

C03L1 = A1 & B4 & B5 & C2L1;


--C44L1 is mac42:S3|fa1:F2|O1~10 at LC_X1_Y1_N3
--operation mode is normal

C44L1 = B7 & B6 & A1 & C2L1;


--C44L2 is mac42:S3|fa1:F2|X2~41 at LC_X1_Y2_N2
--operation mode is normal

C44L2 = B7 & A1 & (!A0 # !B6) # !B7 & B6;


--C44L3 is mac42:S3|fa1:F2|X2~42 at LC_X1_Y2_N3
--operation mode is normal

C44L3 = B7 & (C44L2 $ (A2 & B6)) # !B7 & C44L2 & A2 & B6;


--C03L2 is mac42:S2|fa1:F2|X2~41 at LC_X2_Y3_N5
--operation mode is normal

C03L2 = B5 & A1 & (!B4 # !A0) # !B5 & (B4);


--C03L3 is mac42:S2|fa1:F2|X2~42 at LC_X1_Y3_N7
--operation mode is normal

C03L3 = C03L2 & (B5 $ (A2 & B4)) # !C03L2 & A2 & B5 & B4;


--C61L2 is mac42:S1|fa1:F2|X2~41 at LC_X1_Y4_N2
--operation mode is normal

C61L2 = B3 & A1 & (!A0 # !B2) # !B3 & (B2);


--C61L3 is mac42:S1|fa1:F2|X2~42 at LC_X1_Y4_N1
--operation mode is normal

C61L3 = B3 & (C61L2 $ (B2 & A2)) # !B3 & B2 & A2 & C61L2;


--C2L3 is mac42:S0|fa1:F2|X2~41 at LC_X2_Y4_N5
--operation mode is normal

C2L3 = A2 $ (A1 & !A0 & B1);


--C2L4 is mac42:S0|fa1:F2|X2~42 at LC_X2_Y4_N3
--operation mode is normal

C2L4 = B0 & (C2L3) # !B0 & A1 & (B1);


--A0 is A0 at PIN_V21
--operation mode is input

A0 = INPUT();


--B0 is B0 at PIN_T20
--operation mode is input

B0 = INPUT();


--A1 is A1 at PIN_Y21
--operation mode is input

A1 = INPUT();


--B1 is B1 at PIN_T18
--operation mode is input

B1 = INPUT();


