P6 = OUTPUT(C15_X1);


--P7 is P7 at PIN_U19
--operation mode is output

P7 = OUTPUT(C25L2);


--P8 is P8 at PIN_U20
--operation mode is output

P8 = OUTPUT(C35L2);


--P9 is P9 at PIN_W20
--operation mode is output

P9 = OUTPUT(C45L2);


--P10 is P10 at PIN_AA20
