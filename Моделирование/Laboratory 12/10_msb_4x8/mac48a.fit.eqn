--C4_Q00 is mac44:U|mac42:U|Q00 at LC_X1_Y6_N0
--operation mode is normal

C4_Q00 = A0 & (B0);


--D34_X1 is mac44:U|mac42:U|fa1:F1|X1 at LC_X2_Y4_N9
--operation mode is normal

D34_X1 = A1 & (B0 $ (A0 & B1)) # !A1 & (A0 & B1);


--C3_Q00 is mac44:U|mac42:L|Q00 at LC_X2_Y4_N7
--operation mode is normal

C3_Q00 = A0 & B2;


--D92_X1 is mac44:U|mac42:L|fa1:F1|X1 at LC_X1_Y4_N0
--operation mode is normal

D92_X1 = A1 & (B2 $ (B3 & A0)) # !A1 & (B3 & A0);


--C4_Q03 is mac44:U|mac42:U|Q03 at LC_X2_Y4_N6
--operation mode is normal

C4_Q03 = A3 & (B0);


--D54_X2 is mac44:U|mac42:U|fa1:F3|X2 at LC_X2_Y4_N0
--operation mode is normal

D54_X2 = C4_Q03 $ D44L2 $ (B1 & A2);


--D83_X2 is mac44:U|mac42:L|fa1:H2|X2 at LC_X2_Y4_N2
--operation mode is normal

D83_X2 = D54_X2 $ D92_X1 $ (D44L4 & C3_Q00);


--C2_Q00 is mac44:L|mac42:U|Q00 at LC_X2_Y3_N7
--operation mode is normal

C2_Q00 = A0 & B4;


--C4_Q13 is mac44:U|mac42:U|Q13 at LC_X2_Y2_N2
--operation mode is normal

C4_Q13 = A3 & (B1);


--D83L1 is mac44:U|mac42:L|fa1:H2|O1~1 at LC_X2_Y4_N1
--operation mode is normal

D83L1 = D54_X2 & (D92_X1 # D44L4 & C3_Q00) # !D54_X2 & D44L4 & C3_Q00 & D92_X1;


--D54L1 is mac44:U|mac42:U|fa1:F3|O1~1 at LC_X2_Y4_N8
--operation mode is normal

D54L1 = C4_Q03 & (D44L2 # B1 & A2) # !C4_Q03 & B1 & A2 & D44L2;


--D93_X2 is mac44:U|mac42:L|fa1:H3|X2 at LC_X2_Y3_N0
--operation mode is normal

D93_X2 = D83L1 $ D03L3 $ D54L1 $ C4_Q13;


--C3_Q03 is mac44:U|mac42:L|Q03 at LC_X1_Y4_N3
--operation mode is normal

C3_Q03 = B2 & (A3);


--D13_X2 is mac44:U|mac42:L|fa1:F3|X2 at LC_X1_Y4_N7
--operation mode is normal

D13_X2 = C3_Q03 $ D03L1 $ (A2 & B3);


--D93L1 is mac44:U|mac42:L|fa1:H3|O1~1 at LC_X2_Y3_N6
--operation mode is normal

D93L1 = D83L1 & (D03L3 # D54L1 $ C4_Q13) # !D83L1 & D03L3 & (D54L1 $ C4_Q13);


--D04_X2 is mac44:U|mac42:L|fa1:H4|X2 at LC_X2_Y3_N3
--operation mode is normal

D04_X2 = D13_X2 $ D93L1 $ (D54L1 & C4_Q13);


--D51_X1 is mac44:L|mac42:U|fa1:F1|X1 at LC_X2_Y3_N8
--operation mode is normal

D51_X1 = A1 & (B4 $ (B5 & A0)) # !A1 & B5 & A0;


--D42_X2 is mac44:L|mac42:U|fa1:H2|X2 at LC_X2_Y3_N1
--operation mode is normal

D42_X2 = D04_X2 $ D51_X1 $ (D93_X2 & C2_Q00);


--C1_Q00 is mac44:L|mac42:L|Q00 at LC_X1_Y2_N7
--operation mode is normal

C1_Q00 = A0 & B6;


--D13L1 is mac44:U|mac42:L|fa1:F3|O1~3 at LC_X1_Y4_N4
--operation mode is normal

D13L1 = D03L1 & (C3_Q03 # B3 & A2) # !D03L1 & B3 & A2 & C3_Q03;


--D23_X2 is mac44:U|mac42:L|fa1:F4|X2 at LC_X1_Y4_N9
--operation mode is normal

D23_X2 = D13L1 $ (A3 & B3);


--D42L1 is mac44:L|mac42:U|fa1:H2|O1~1 at LC_X2_Y3_N9
--operation mode is normal

D42L1 = D04_X2 & (D51_X1 # D93_X2 & C2_Q00) # !D04_X2 & D93_X2 & C2_Q00 & D51_X1;


--D04L1 is mac44:U|mac42:L|fa1:H4|O1~1 at LC_X2_Y3_N2
--operation mode is normal

D04L1 = D13_X2 & (D93L1 # D54L1 & C4_Q13) # !D13_X2 & D93L1 & D54L1 & C4_Q13;


--D52L2 is mac44:L|mac42:U|fa1:H3|X2~19 at LC_X1_Y2_N9
--operation mode is normal

D52L2 = D42L1 $ D04L1 $ D23_X2 $ D61L3;


--C2_Q03 is mac44:L|mac42:U|Q03 at LC_X1_Y3_N4
--operation mode is normal

C2_Q03 = A3 & B4;


--D71_X2 is mac44:L|mac42:U|fa1:F3|X2 at LC_X1_Y3_N2
--operation mode is normal

D71_X2 = C2_Q03 $ D61L1 $ (B5 & A2);


--D14_A2 is mac44:U|mac42:L|fa1:H5|A2 at LC_X1_Y3_N3
--operation mode is normal

D14_A2 = D04L1 & (D13L1 $ (A3 & B3));


--D23_A2 is mac44:U|mac42:L|fa1:F4|A2 at LC_X1_Y3_N9
--operation mode is normal

D23_A2 = A3 & D13L1 & B3;


--D52L1 is mac44:L|mac42:U|fa1:H3|O1~1 at LC_X1_Y3_N8
--operation mode is normal

D52L1 = D61L3 & (D42L1 # D23_X2 $ D04L1) # !D61L3 & D42L1 & (D23_X2 $ D04L1);


--D62L2 is mac44:L|mac42:U|fa1:H4|X2~17 at LC_X1_Y3_N1
--operation mode is normal

D62L2 = D52L1 $ D23_A2 $ D14_A2 $ D71_X2;


--D1_X1 is mac44:L|mac42:L|fa1:F1|X1 at LC_X1_Y2_N8
--operation mode is normal

D1_X1 = B6 & (A1 $ (A0 & B7)) # !B6 & (A0 & B7);


--D01L2 is mac44:L|mac42:L|fa1:H2|X2~14 at LC_X1_Y2_N6
--operation mode is normal

D01L2 = D1_X1 $ D62L2 $ (D52L2 & C1_Q00);


--D71L1 is mac44:L|mac42:U|fa1:F3|O1~3 at LC_X1_Y3_N6
--operation mode is normal

D71L1 = C2_Q03 & (D61L1 # B5 & A2) # !C2_Q03 & B5 & A2 & D61L1;


--D81_X2 is mac44:L|mac42:U|fa1:F4|X2 at LC_X2_Y2_N4
--operation mode is normal

D81_X2 = D71L1 $ (A3 & B5);


--D01L1 is mac44:L|mac42:L|fa1:H2|O1~1 at LC_X1_Y2_N1
--operation mode is normal

D01L1 = D1_X1 & (D62L2 # D52L2 & C1_Q00) # !D1_X1 & D52L2 & C1_Q00 & D62L2;


--D62L1 is mac44:L|mac42:U|fa1:H4|O1~1 at LC_X1_Y3_N0
--operation mode is normal

D62L1 = D52L1 & (D71_X2 # D23_A2 $ D14_A2) # !D52L1 & D71_X2 & (D23_A2 $ D14_A2);


--D11L2 is mac44:L|mac42:L|fa1:H3|X2~18 at LC_X1_Y2_N4
--operation mode is normal

D11L2 = D2L3 $ D01L1 $ D81_X2 $ D62L1;


--C1_Q03 is mac44:L|mac42:L|Q03 at LC_X1_Y1_N0
--operation mode is normal

C1_Q03 = A3 & (B6);


--D3_X2 is mac44:L|mac42:L|fa1:F3|X2 at LC_X1_Y1_N5
--operation mode is normal

D3_X2 = C1_Q03 $ D2L1 $ (A2 & B7);


--D72_A2 is mac44:L|mac42:U|fa1:H5|A2 at LC_X1_Y1_N7
--operation mode is normal

D72_A2 = D62L1 & (D71L1 $ (A3 & B5));


--D81_A2 is mac44:L|mac42:U|fa1:F4|A2 at LC_X1_Y1_N8
--operation mode is normal

D81_A2 = A3 & (B5 & D71L1);


--D11L1 is mac44:L|mac42:L|fa1:H3|O1~1 at LC_X1_Y2_N5
--operation mode is normal

D11L1 = D2L3 & (D01L1 # D81_X2 $ D62L1) # !D2L3 & D01L1 & (D81_X2 $ D62L1);


--D21L2 is mac44:L|mac42:L|fa1:H4|X2~16 at LC_X1_Y1_N1
--operation mode is normal

D21L2 = D72_A2 $ D3_X2 $ D11L1 $ D81_A2;


--D3L1 is mac44:L|mac42:L|fa1:F3|O1~1 at LC_X1_Y1_N4
--operation mode is normal

D3L1 = C1_Q03 & (D2L1 # B7 & A2) # !C1_Q03 & B7 & A2 & D2L1;


--D21L1 is mac44:L|mac42:L|fa1:H4|O1~1 at LC_X1_Y1_N2
--operation mode is normal

D21L1 = D3_X2 & (D11L1 # D72_A2 $ D81_A2) # !D3_X2 & D11L1 & (D72_A2 $ D81_A2);


--D31_X2 is mac44:L|mac42:L|fa1:H5|X2 at LC_X1_Y1_N9
--operation mode is normal

D31_X2 = D3L1 $ D21L1 $ (A3 & B7);


--D41_X2 is mac44:L|mac42:L|fa1:H6|X2 at LC_X1_Y1_N6
--operation mode is normal

D41_X2 = D3L1 & (D21L1 # A3 & B7) # !D3L1 & A3 & B7 & D21L1;


--D73_X1 is mac44:U|mac42:L|fa1:H1|X1 at LC_X2_Y4_N4
--operation mode is normal

D73_X1 = D44L4 $ (B2 & A0);


--D32_X1 is mac44:L|mac42:U|fa1:H1|X1 at LC_X2_Y3_N4
--operation mode is normal

D32_X1 = D93_X2 $ (B4 & A0);


--D9_X1 is mac44:L|mac42:L|fa1:H1|X1 at LC_X1_Y2_N0
--operation mode is normal

D9_X1 = D52L2 $ (B6 & A0);


--D44L1 is mac44:U|mac42:U|fa1:F2|O1~4 at LC_X1_Y4_N8
--operation mode is normal

D44L1 = A2 # A0;


--D44L2 is mac44:U|mac42:U|fa1:F2|O1~10 at LC_X1_Y4_N6
--operation mode is normal

D44L2 = B0 & B1 & A1 & D44L1;


--D03L1 is mac44:U|mac42:L|fa1:F2|O1~10 at LC_X1_Y4_N5
--operation mode is normal

D03L1 = B3 & B2 & A1 & D44L1;


--D61L1 is mac44:L|mac42:U|fa1:F2|O1~10 at LC_X1_Y3_N5
--operation mode is normal

D61L1 = A1 & B4 & B5 & D44L1;


--D2L1 is mac44:L|mac42:L|fa1:F2|O1~10 at LC_X1_Y1_N3
--operation mode is normal

D2L1 = B7 & B6 & A1 & D44L1;


--D2L2 is mac44:L|mac42:L|fa1:F2|X2~41 at LC_X1_Y2_N2
--operation mode is normal

D2L2 = B7 & A1 & (!A0 # !B6) # !B7 & B6;


--D2L3 is mac44:L|mac42:L|fa1:F2|X2~42 at LC_X1_Y2_N3
--operation mode is normal

D2L3 = B7 & (D2L2 $ (A2 & B6)) # !B7 & D2L2 & A2 & B6;


--D61L2 is mac44:L|mac42:U|fa1:F2|X2~41 at LC_X2_Y3_N5
--operation mode is normal

D61L2 = B5 & A1 & (!B4 # !A0) # !B5 & (B4);


--D61L3 is mac44:L|mac42:U|fa1:F2|X2~42 at LC_X1_Y3_N7
--operation mode is normal

D61L3 = D61L2 & (B5 $ (A2 & B4)) # !D61L2 & A2 & B5 & B4;


--D03L2 is mac44:U|mac42:L|fa1:F2|X2~41 at LC_X1_Y4_N2
--operation mode is normal

D03L2 = B3 & A1 & (!A0 # !B2) # !B3 & (B2);


--D03L3 is mac44:U|mac42:L|fa1:F2|X2~42 at LC_X1_Y4_N1
--operation mode is normal

D03L3 = B3 & (D03L2 $ (B2 & A2)) # !B3 & B2 & A2 & D03L2;


--D44L3 is mac44:U|mac42:U|fa1:F2|X2~41 at LC_X2_Y4_N5
--operation mode is normal

D44L3 = A2 $ (A1 & !A0 & B1);


--D44L4 is mac44:U|mac42:U|fa1:F2|X2~42 at LC_X2_Y4_N3
--operation mode is normal

D44L4 = B0 & (D44L3) # !B0 & A1 & (B1);


--A0 is A0 at PIN_V21
--operation mode is input

A0 = INPUT();


--B0 is B0 at PIN_T20
--operation mode is input

B0 = INPUT();


--A1 is A1 at PIN_Y21
--operation mode is input

A1 = INPUT();


--B1 is B1 at PIN_T18
--operation mode is input

B1 = INPUT();


--B2 is B2 at PIN_P19
--operation mode is input

B2 = INPUT();


--A2 is A2 at PIN_W18
--operation mode is input

A2 = INPUT();


--B3 is B3 at PIN_U18
--operation mode is input

B3 = INPUT();


--A3 is A3 at PIN_AB19
--operation mode is input

A3 = INPUT();


--B4 is B4 at PIN_W22
--operation mode is input

B4 = INPUT();


--B5 is B5 at PIN_AA18
--operation mode is input

B5 = INPUT();


--B6 is B6 at PIN_AA21
--operation mode is input

B6 = INPUT();


--B7 is B7 at PIN_Y20
--operation mode is input

B7 = INPUT();


--P0 is P0 at PIN_V22
--operation mode is output

P0 = OUTPUT(C4_Q00);


--P1 is P1 at PIN_Y19
--operation mode is output

P1 = OUTPUT(D34_X1);


--P2 is P2 at PIN_P17
--operation mode is output

P2 = OUTPUT(D73_X1);


--P3 is P3 at PIN_T19
--operation mode is output

P3 = OUTPUT(D83_X2);


--P4 is P4 at PIN_AA19
--operation mode is output

P4 = OUTPUT(D32_X1);


--P5 is P5 at PIN_AA17
--operation mode is output

P5 = OUTPUT(D42_X2);


--P6 is P6 at PIN_W21
--operation mode is output

P6 = OUTPUT(D9_X1);


--P7 is P7 at PIN_U19
--operation mode is output

P7 = OUTPUT(D01L2);


--P8 is P8 at PIN_U20
--operation mode is output

P8 = OUTPUT(D11L2);


--P9 is P9 at PIN_W20
--operation mode is output

P9 = OUTPUT(D21L2);


--P10 is P10 at PIN_AA20
--operation mode is output

P10 = OUTPUT(D31_X2);


--P11 is P11 at PIN_W19
--operation mode is output

P11 = OUTPUT(D41_X2);



