--H3L8 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~50
--operation mode is arithmetic

H3L8 = CARRY(!H3L6 # !D1_decoder_node[1][3]);


--H6L3 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[1]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~38
--operation mode is arithmetic

H6L3_carry_eqn = H6L2;
H6L3 = D1_decoder_node[2][2] $ D1_decoder_node[3][1] $ H6L3_carry_eqn;

--H6L4 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[1]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~40
--operation mode is arithmetic

H6L4 = CARRY(D1_decoder_node[2][2] & !D1_decoder_node[3][1] & !H6L2 # !D1_decoder_node[2][2] & (!H6L2 # !D1_decoder_node[3][1]));


--H3L9 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~53
