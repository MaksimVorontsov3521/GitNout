--H3L1 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~33
--operation mode is arithmetic

H3L1 = D1_decoder_node[0][1] $ D1_decoder_node[1][0];

--H3L2 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~35
--operation mode is arithmetic

H3L2 = CARRY(D1_decoder_node[0][1] & D1_decoder_node[1][0]);


--H9L1 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~42
--operation mode is arithmetic

H9L1 = H3L3 $ D1_decoder_node[2][0];

--H9L2 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~44
--operation mode is arithmetic

H9L2 = CARRY(H3L3 & D1_decoder_node[2][0]);


--H9L3 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~47
--operation mode is arithmetic

H9L3_carry_eqn = H9L2;
H9L3 = H3L5 $ H6L1 $ H9L3_carry_eqn;

--H9L4 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~49
--operation mode is arithmetic

H9L4 = CARRY(H3L5 & !H6L1 & !H9L2 # !H3L5 & (!H9L2 # !H6L1));


--H9L5 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~52
--operation mode is arithmetic

H9L5_carry_eqn = H9L4;
H9L5 = H3L7 $ H6L3 $ !H9L5_carry_eqn;

--H9L6 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~54
--operation mode is arithmetic

H9L6 = CARRY(H3L7 & (H6L3 # !H9L4) # !H3L7 & H6L3 & !H9L4);


--H9L7 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~57
--operation mode is arithmetic

H9L7_carry_eqn = H9L6;
H9L7 = H3L9 $ H6L5 $ H9L7_carry_eqn;

--H9L8 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~59
--operation mode is arithmetic

H9L8 = CARRY(H3L9 & !H6L5 & !H9L6 # !H3L9 & (!H9L6 # !H6L5));


--H9L9 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~62
--operation mode is arithmetic

H9L9_carry_eqn = H9L8;
H9L9 = H6L7 $ (!H9L9_carry_eqn);

--H9L01 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~64
--operation mode is arithmetic

H9L01 = CARRY(H6L7 & (!H9L8));


--H9L11 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|mpar_add:sub_par_add|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~67
--operation mode is normal

H9L11_carry_eqn = H9L01;
H9L11 = H6L9 $ (H9L11_carry_eqn);


--D1_decoder_node[0][0] is lpm_mult:U1|multcore:mult_core|decoder_node[0][0]
--operation mode is normal

D1_decoder_node[0][0] = LCELL(DATAA[0] & DATAB[0]);


--H3L3 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~38
