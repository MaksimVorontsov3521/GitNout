--operation mode is arithmetic

H3L6 = CARRY(D1_decoder_node[0][3] & (D1_decoder_node[1][2] # !H3L4) # !D1_decoder_node[0][3] & D1_decoder_node[1][2] & !H3L4);


--H6L1 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[1]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~33
--operation mode is arithmetic

