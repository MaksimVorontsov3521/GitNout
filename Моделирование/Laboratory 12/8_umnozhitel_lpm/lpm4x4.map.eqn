--operation mode is arithmetic

H3L4 = CARRY(D1_decoder_node[0][2] & !D1_decoder_node[1][1] & !H3L2 # !D1_decoder_node[0][2] & (!H3L2 # !D1_decoder_node[1][1]));


--H3L5 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[0]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~43
--operation mode is arithmetic

H3L5_carry_eqn = H3L4;
