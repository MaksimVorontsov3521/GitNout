--operation mode is arithmetic

H6L6 = CARRY(D1_decoder_node[2][3] & (D1_decoder_node[3][2] # !H6L4) # !D1_decoder_node[2][3] & D1_decoder_node[3][2] & !H6L4);


--H6L7 is lpm_mult:U1|multcore:mult_core|mpar_add:padder|lpm_add_sub:adder[1]|addcore:adder|a_csnbuffer:result_node|cs_buffer[0]~48
--operation mode is arithmetic

