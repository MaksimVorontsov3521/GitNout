--B1L01 is 7483:U1|54~18 at LC_X52_Y1_N6
--operation mode is normal

B1L01 = !CI & !B[0];


--B1L1 is 7483:U1|1~221 at LC_X52_Y1_N4
--operation mode is normal

B1L1 = !A[0] & (!B[0] # !CI);


--B1L2 is 7483:U1|1~222 at LC_X52_Y1_N9
--operation mode is normal

B1L2 = A[1] & (B[1] # !B1L01 & !B1L1) # !A[1] & !B1L01 & B[1] & !B1L1;


--B1L3 is 7483:U1|1~223 at LC_X52_Y1_N1
--operation mode is normal

B1L3 = A[2] & !B[2] & !B1L2 # !A[2] & (!B1L2 # !B[2]);


--B1L4 is 7483:U1|2~69 at LC_X52_Y1_N3
--operation mode is normal

B1L4 = B[3] & !A[3] & B1L3 # !B[3] & (B1L3 # !A[3]);


--B1_45 is 7483:U1|45 at LC_X52_Y1_N2
--operation mode is normal

B1_45 = B[3] $ A[3] $ (B1L3);


--B1L9 is 7483:U1|51~116 at LC_X52_Y1_N8
--operation mode is normal

B1L9 = A[1] & !B[1] & (B1L01 # B1L1) # !A[1] & (B1L01 # B1L1 # !B[1]);


--B1_44 is 7483:U1|44 at LC_X52_Y1_N7
--operation mode is normal

B1_44 = A[2] $ B[2] $ B1L9;


--B1_43 is 7483:U1|43 at LC_X52_Y1_N5
--operation mode is normal

B1_43 = A[1] $ B[1] $ (B1L01 # B1L1);


--B1L5 is 7483:U1|42~13 at LC_X52_Y1_N0
--operation mode is normal

B1L5 = A[0] $ (CI $ B[0]);


--B[2] is B[2] at PIN_V4
--operation mode is input

B[2] = INPUT();


--A[2] is A[2] at PIN_W4
--operation mode is input

A[2] = INPUT();


--B[0] is B[0] at PIN_W2
--operation mode is input

B[0] = INPUT();


--CI is CI at PIN_Y3
--operation mode is input

CI = INPUT();


--A[0] is A[0] at PIN_T5
--operation mode is input

A[0] = INPUT();


--B[1] is B[1] at PIN_T7
--operation mode is input

B[1] = INPUT();


--A[1] is A[1] at PIN_AA4
--operation mode is input

A[1] = INPUT();


--B[3] is B[3] at PIN_W3
--operation mode is input

B[3] = INPUT();


--A[3] is A[3] at PIN_AA2
--operation mode is input

A[3] = INPUT();


--CO is CO at PIN_P7
--operation mode is output

CO = OUTPUT(!B1L4);


--S[3] is S[3] at PIN_W1
--operation mode is output

S[3] = OUTPUT(!B1_45);


--S[2] is S[2] at PIN_U5
--operation mode is output

S[2] = OUTPUT(!B1_44);


--S[1] is S[1] at PIN_AA3
--operation mode is output

S[1] = OUTPUT(!B1_43);


--S[0] is S[0] at PIN_V3
--operation mode is output

S[0] = OUTPUT(B1L5);



