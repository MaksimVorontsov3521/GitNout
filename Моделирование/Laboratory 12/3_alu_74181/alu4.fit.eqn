--B1L8 is 74181:U1|52~51 at LC_X7_Y30_N6
--operation mode is normal

B1L8 = A[3] & (B[3] & S[3] # !B[3] & (S[2]));


--B1L3 is 74181:U1|45~10 at LC_X7_Y30_N2
--operation mode is normal

B1L3 = A[2] # B[2] & (S[0]) # !B[2] & S[1];


--B1L7 is 74181:U1|51~17 at LC_X7_Y30_N3
--operation mode is normal

B1L7 = A[3] # B[3] & S[0] # !B[3] & (S[1]);


--B1L2 is 74181:U1|44~16 at LC_X6_Y30_N2
--operation mode is normal

B1L2 = A[1] # B[1] & (S[0]) # !B[1] & S[1];


--B1L5 is 74181:U1|47~51 at LC_X7_Y30_N0
--operation mode is normal

B1L5 = A[1] & (B[1] & (S[3]) # !B[1] & S[2]);


--B1L1 is 74181:U1|43~13 at LC_X7_Y30_N9
--operation mode is normal

B1L1 = A[0] # B[0] & (S[0]) # !B[0] & S[1];


--B1L6 is 74181:U1|48~51 at LC_X7_Y30_N5
--operation mode is normal

B1L6 = A[2] & (B[2] & (S[3]) # !B[2] & S[2]);


--B1L01 is 74181:U1|63~158 at LC_X8_Y30_N9
--operation mode is normal

B1L01 = B1L6 # B1L2 & (B1L5 # B1L1);


--B1L11 is 74181:U1|63~159 at LC_X7_Y30_N7
--operation mode is normal

B1L11 = !B1L8 & (!B1L01 # !B1L3) # !B1L7;


--B1L4 is 74181:U1|46~51 at LC_X7_Y30_N4
--operation mode is normal

B1L4 = A[0] & (B[0] & S[3] # !B[0] & (S[2]));


--B1L9 is 74181:U1|60~20 at LC_X7_Y30_N1
--operation mode is normal

B1L9 = !B1L8 & !B1L5 & !B1L6 & !B1L4;


--B1_78 is 74181:U1|78 at LC_X7_Y30_N8
--operation mode is normal

B1_78 = B1L11 # CN & B1L9;


--B1L41 is 74181:U1|77~195 at LC_X8_Y30_N1
--operation mode is normal

B1L41 = B1L5 # B1L1 & (B1L4 # !CN);


--B1L51 is 74181:U1|77~196 at LC_X8_Y30_N5
--operation mode is normal

B1L51 = B1L3 & (B1L6 # B1L2 & B1L41);


--B1L61 is 74181:U1|77~197 at LC_X8_Y30_N6
--operation mode is normal

B1L61 = B1L8 $ B1L7 $ (M # B1L51);


--B1L21 is 74181:U1|66~19 at LC_X8_Y30_N8
--operation mode is normal

B1L21 = CN & !B1L4;


--B1L31 is 74181:U1|75~324 at LC_X8_Y30_N3
--operation mode is normal

B1L31 = !B1L5 & (B1L21 # !B1L1) # !B1L2;


--B1_82 is 74181:U1|82 at LC_X8_Y30_N4
--operation mode is normal

B1_82 = B1L3 $ B1L6 $ (M # !B1L31);


--B1L02 is 74181:U1|81~119 at LC_X6_Y30_N4
--operation mode is normal

B1L02 = B1L5 $ B1L2;


--B1_81 is 74181:U1|81 at LC_X8_Y30_N0
--operation mode is normal

B1_81 = B1L02 $ (M # B1L1 & !B1L21);


--B1L81 is 74181:U1|80~85 at LC_X8_Y30_N7
--operation mode is normal

B1L81 = B1L1 $ B1L4 $ (!M & CN);


--B1L22 is 74181:U1|83~29 at LC_X8_Y30_N2
--operation mode is normal

B1L22 = B1_82 & B1L61 & !B1L81 & B1_81;


--A[3] is A[3] at PIN_B19
--operation mode is input

A[3] = INPUT();


--S[3] is S[3] at PIN_F16
--operation mode is input

S[3] = INPUT();


--S[2] is S[2] at PIN_E17
--operation mode is input

S[2] = INPUT();


--B[3] is B[3] at PIN_A17
--operation mode is input

B[3] = INPUT();


--A[2] is A[2] at PIN_B18
--operation mode is input

A[2] = INPUT();


--S[0] is S[0] at PIN_D18
--operation mode is input

S[0] = INPUT();


--S[1] is S[1] at PIN_C18
--operation mode is input

S[1] = INPUT();


--B[2] is B[2] at PIN_E18
--operation mode is input

B[2] = INPUT();


--A[1] is A[1] at PIN_D17
--operation mode is input

A[1] = INPUT();


--B[1] is B[1] at PIN_A18
--operation mode is input

B[1] = INPUT();


--A[0] is A[0] at PIN_B17
--operation mode is input

A[0] = INPUT();


--B[0] is B[0] at PIN_C21
--operation mode is input

B[0] = INPUT();


--CN is CN at PIN_B16
--operation mode is input

CN = INPUT();


--M is M at PIN_G16
--operation mode is input

M = INPUT();


--GN is GN at PIN_F17
--operation mode is output

GN = OUTPUT(!B1L11);


--PN is PN at PIN_D16
--operation mode is output

PN = OUTPUT(!B1L9);


--CN4 is CN4 at PIN_C17
--operation mode is output

CN4 = OUTPUT(B1_78);


--AEQB is AEQB at PIN_F15
--operation mode is output

AEQB = OUTPUT(B1L22);


--F[3] is F[3] at PIN_E16
--operation mode is output

F[3] = OUTPUT(B1L61);


--F[2] is F[2] at PIN_D15
--operation mode is output

F[2] = OUTPUT(B1_82);


--F[1] is F[1] at PIN_A16
--operation mode is output

F[1] = OUTPUT(B1_81);


--F[0] is F[0] at PIN_C16
--operation mode is output

F[0] = OUTPUT(!B1L81);



