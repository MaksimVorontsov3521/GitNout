--IN is IN at PIN_D2
--operation mode is input

IN = INPUT();


--OE is OE at PIN_D1
--operation mode is input

OE = INPUT();


--OUT is OUT at PIN_F3
--operation mode is output

OUT_tri_out = TRI(IN, OE);
OUT = OUTPUT(OUT_tri_out);



