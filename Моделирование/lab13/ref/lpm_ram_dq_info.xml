<?xml version="1.0"?>
<ROOT>
	<PARAMETERS>
		<PARAMETER NAME="INTENDED_DEVICE_FAMILY" TYPE="STRING" VALUE="UNUSED" />
		<PARAMETER NAME="ENABLE_RUNTIME_MOD" TYPE="STRING" VALUE="NO|YES" DEFAULT_VALUE_INDEX="0" LPM_HINT="ON" />
		<PARAMETER NAME="INSTANCE_NAME" TYPE="STRING" VALUE="UNUSED" DEFAULT_VALUE_INDEX="0" LPM_HINT="ON" />
		<PARAMETER NAME="LPM_ADDRESS_CONTROL" TYPE="STRING" VALUE="REGISTERED|UNREGISTERED" DEFAULT_VALUE_INDEX="0" />
		<PARAMETER NAME="LPM_FILE" TYPE="STRING" VALUE="UNUSED" DEFAULT_VALUE_INDEX="0" />
		<PARAMETER NAME="LPM_INDATA" TYPE="STRING" VALUE="REGISTERED|UNREGISTERED" DEFAULT_VALUE_INDEX="0" />
		<PARAMETER NAME="LPM_NUMWORDS" TYPE="INTEGER" VALUE="0" />
		<PARAMETER NAME="LPM_OUTDATA" TYPE="STRING" VALUE="REGISTERED|UNREGISTERED" DEFAULT_VALUE_INDEX="0" />
		<PARAMETER NAME="LPM_WIDTH" TYPE="INTEGER" />
		<PARAMETER NAME="LPM_WIDTHAD" TYPE="INTEGER" />
		<PARAMETER NAME="LPM_HINT" TYPE="STRING" VALUE="UNUSED" />
		<PARAMETER NAME="LPM_TYPE" TYPE="STRING" VALUE="lpm_ram_dq" />
	</PARAMETERS>
	<PORTS>
		<PORT NAME="address" TYPE="INPUT" WIDTH="LPM_WIDTHAD" DEFAULT_VALUE="0" />
		<PORT NAME="data" TYPE="INPUT" WIDTH="LPM_WIDTH" />
		<PORT NAME="inclock" TYPE="INPUT" DEFAULT_VALUE="1" />
		<PORT NAME="outclock" TYPE="INPUT" DEFAULT_VALUE="1" />
		<PORT NAME="q" TYPE="OUTPUT" WIDTH="LPM_WIDTH" />
		<PORT NAME="we" TYPE="INPUT" DEFAULT_VALUE="1" />
	</PORTS>
</ROOT>
