------------------------------------------------------------------
--  Lab 13, task 4: the LPM_RAM_DQ megafunction from the library
--
--  Configuration fixed by the assignment (chapter 18, task 4):
--
--      LPM_ADDRESS_CONTROL  "unregistered"
--      LPM_FILE             <none>        (left at its default, so no
--                                          initialisation file is used)
--      LPM_INDATA           "unregistered"
--      LPM_NUMWORDS         <none>        (left at its default, which
--                                          lpm_ram_dq.tdf defines as 2^LPM_WIDTHAD)
--      LPM_OUTDATA          "unregistered"
--      LPM_WIDTH            8
--      LPM_WIDTHAD          10
--
--  Only the inputs WE, ADDRESS, DATA and the output Q are brought out, as the
--  task requires ("leave only the inputs WE, ADDRESS, DATA and the output Q").
--  inclock and outclock are deliberately NOT connected: lpm_ram_dq.tdf declares
--  both with a default of VCC, and with all three registration parameters set to
--  UNREGISTERED there is no register left to clock, so the design really has only
--  the four ports the task asks for.
--
--  Device family: ACEX1K. Measured in this Quartus II 5.0 installation, the
--  parameter set above (an asynchronous-read single-port RAM) is REFUSED by
--  Stratix and by Cyclone ("Can't convert single-port RAM ... because the family
--  supports only synchronous single-port RAM", altram.tdf line 236 reached from
--  lpm_ram_dq.tdf line 89), and MAX3000A elaborates but then aborts with an
--  internal error in the state synthesiser (scl_state_syn.cpp line 1302).
--  ACEX1K and FLEX10KE both analyse and simulate it successfully; only the
--  fitter needs a device database, and this installation ships devices for the
--  Stratix family alone, so the fit step is not available for task 4.
------------------------------------------------------------------
INCLUDE "lpm_ram_dq.inc";

SUBDESIGN lpramax
(
	data[7..0]	: INPUT;
	address[9..0]	: INPUT;
	we		: INPUT;
	q[7..0]		: OUTPUT;
)

VARIABLE
	mem : lpm_ram_dq WITH (
		LPM_WIDTH = 8,
		LPM_WIDTHAD = 10,
		LPM_ADDRESS_CONTROL = "UNREGISTERED",
		LPM_INDATA = "UNREGISTERED",
		LPM_OUTDATA = "UNREGISTERED");

BEGIN
	mem.data[] = data[];
	mem.address[] = address[];
	mem.we = we;
	q[] = mem.q[];
END;
