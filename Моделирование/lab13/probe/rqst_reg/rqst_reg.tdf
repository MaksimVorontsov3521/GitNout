------------------------------------------------------------------
-- Lab 13 probe rqst_reg: LPM_RAM_DQ with the exact parameter set the assignment
-- fixes (width 8, widthad 10, address/data/output unregistered, no init file),
-- on family Stratix, LPM_OUTDATA="REGISTERED".
------------------------------------------------------------------
INCLUDE "lpm_ram_dq.inc";

SUBDESIGN rqst_reg
(
	data[7..0]	: INPUT;
	address[9..0]	: INPUT;
	we		: INPUT;
	q[7..0]		: OUTPUT;
)

VARIABLE
	u1 : lpm_ram_dq WITH (
		LPM_WIDTH = 8,
		LPM_WIDTHAD = 10,
		LPM_ADDRESS_CONTROL = "UNREGISTERED",
		LPM_INDATA = "UNREGISTERED",
		LPM_OUTDATA = "REGISTERED");

BEGIN
	u1.data[] = data[];
	u1.address[] = address[];
	u1.we = we;
	q[] = u1.q[];
END;
