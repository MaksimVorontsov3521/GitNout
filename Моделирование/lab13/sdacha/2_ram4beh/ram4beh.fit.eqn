--cell[0] is cell[0] at LC_X36_Y1_N9
--operation mode is normal

cell[0]_lut_out = GND;
cell[0] = DFFEAS(cell[0]_lut_out, GLOBAL(clk), VCC, , A1L6, d, , , VCC);


--A1L61 is sel_bit~12 at LC_X36_Y1_N2
--operation mode is normal

cell[1]_qfbk = cell[1];
A1L61 = a[1] & (a[0]) # !a[1] & (a[0] & (cell[1]_qfbk) # !a[0] & cell[0]);

--cell[1] is cell[1] at LC_X36_Y1_N2
--operation mode is normal

cell[1] = DFFEAS(A1L61, GLOBAL(clk), VCC, , A1L8, d, , , VCC);


--cell[3] is cell[3] at LC_X35_Y1_N4
--operation mode is normal

cell[3]_lut_out = d;
cell[3] = DFFEAS(cell[3]_lut_out, GLOBAL(clk), VCC, , A1L21, , , , );


--A1L71 is sel_bit~13 at LC_X35_Y1_N9
--operation mode is normal

cell[2]_qfbk = cell[2];
A1L71 = a[1] & (A1L61 & cell[3] # !A1L61 & (cell[2]_qfbk)) # !a[1] & (A1L61);

--cell[2] is cell[2] at LC_X35_Y1_N9
--operation mode is normal

cell[2] = DFFEAS(A1L71, GLOBAL(clk), VCC, , A1L01, d, , , VCC);


--A1L01 is cell[2]~1 at LC_X36_Y1_N6
--operation mode is normal

A1L01 = !a[0] & (a[1] & we);


--A1L8 is cell[1]~0 at LC_X36_Y1_N8
--operation mode is normal

A1L8 = a[0] & (!a[1] & we);


--A1L6 is cell[0]~63 at LC_X36_Y1_N5
--operation mode is normal

A1L6 = !a[0] & (!a[1] & we);


--A1L21 is cell[3]~2 at LC_X36_Y1_N4
--operation mode is normal

A1L21 = a[0] & (a[1] & we);


--a[1] is a[1] at PIN_U9
--operation mode is input

a[1] = INPUT();


--a[0] is a[0] at PIN_Y8
--operation mode is input

a[0] = INPUT();


--we is we at PIN_Y9
--operation mode is input

we = INPUT();


--d is d at PIN_P8
--operation mode is input

d = INPUT();


--clk is clk at PIN_L2
--operation mode is input

clk = INPUT();


--q is q at PIN_AA8
--operation mode is output

q_tri_out = TRI(A1L71, !we);
q = OUTPUT(q_tri_out);



