--inst is inst at LC3
inst_or_out = D;
inst_reg_input = inst_or_out;
inst = DFFE(inst_reg_input, GLOBAL(C), GLOBAL(R), , );


--inst3 is inst3 at LC5
inst3_or_out = inst;
inst3_reg_input = inst3_or_out;
inst3 = DFFE(inst3_reg_input, !GLOBAL(C), GLOBAL(R), , );


--inst4 is inst4 at LC6
inst4_or_out = inst3;
inst4_reg_input = inst4_or_out;
inst4 = DFFE(inst4_reg_input, GLOBAL(C), GLOBAL(R), , );


--inst5 is inst5 at LC8
inst5_or_out = inst4;
inst5_reg_input = inst5_or_out;
inst5 = DFFE(inst5_reg_input, !GLOBAL(C), GLOBAL(R), , );


--R is R at PIN_1
--operation mode is input

R = INPUT();


--C is C at PIN_83
--operation mode is input

C = INPUT();


--D is D at PIN_81
--operation mode is input

D = INPUT();


--D1 is D1 at PIN_12
--operation mode is output

D1 = OUTPUT(inst);


--Q1 is Q1 at PIN_11
--operation mode is output

Q1 = OUTPUT(inst3);


--D2 is D2 at PIN_10
--operation mode is output

D2 = OUTPUT(inst4);


--Q2 is Q2 at PIN_9
--operation mode is output

Q2 = OUTPUT(inst5);






