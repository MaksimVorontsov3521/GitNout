--m1 is m1
m1_or_out = D;
m1_reg_input = m1_or_out;
m1 = DFFE(m1_reg_input, GLOBAL(C1), GLOBAL(R), , );


--s1 is s1
s1_or_out = m1;
s1_reg_input = s1_or_out;
s1 = DFFE(s1_reg_input, GLOBAL(C2), GLOBAL(R), , );


--m2 is m2
m2_or_out = s1;
m2_reg_input = m2_or_out;
m2 = DFFE(m2_reg_input, GLOBAL(C1), GLOBAL(R), , );


--s2 is s2
s2_or_out = m2;
s2_reg_input = s2_or_out;
s2 = DFFE(s2_reg_input, GLOBAL(C2), GLOBAL(R), , );


--D is D
--operation mode is input

D = INPUT();


--C1 is C1
--operation mode is input

C1 = INPUT();


--C2 is C2
--operation mode is input

C2 = INPUT();


--R is R
--operation mode is input

R = INPUT();


--Q1 is Q1
--operation mode is output

Q1 = OUTPUT(s1);


--Q2 is Q2
--operation mode is output

Q2 = OUTPUT(s2);


