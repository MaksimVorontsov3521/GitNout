--A1L5Q is q~reg0 at LC3
A1L5Q_or_out = data;
A1L5Q_reg_input = A1L5Q_or_out;
A1L5Q = DFFE(A1L5Q_reg_input, GLOBAL(clk), GLOBAL(reset), preset, );


--data is data at PIN_81
--operation mode is input

data = INPUT();


--clk is clk at PIN_83
--operation mode is input

clk = INPUT();


--reset is reset at PIN_1
--operation mode is input

reset = INPUT();


--preset is preset at PIN_33
--operation mode is input

preset = INPUT();


--q is q at PIN_12
--operation mode is output

q = OUTPUT(A1L5Q);






