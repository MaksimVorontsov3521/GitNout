--rs[3] is rs[3]
rs[3]_or_out = data;
rs[3]_reg_input = rs[3]_or_out;
rs[3] = DFFE(rs[3]_reg_input, GLOBAL(clk), GLOBAL(reset), , );


--rs[2] is rs[2]
rs[2]_or_out = rs[3];
rs[2]_reg_input = rs[2]_or_out;
rs[2] = DFFE(rs[2]_reg_input, GLOBAL(clk), GLOBAL(reset), , );


--rs[1] is rs[1]
rs[1]_or_out = rs[2];
rs[1]_reg_input = rs[1]_or_out;
rs[1] = DFFE(rs[1]_reg_input, GLOBAL(clk), GLOBAL(reset), , );


--rs[0] is rs[0]
rs[0]_or_out = rs[1];
rs[0]_reg_input = rs[0]_or_out;
rs[0] = DFFE(rs[0]_reg_input, GLOBAL(clk), GLOBAL(reset), , );


--clk is clk
--operation mode is input

clk = INPUT();


--data is data
--operation mode is input

data = INPUT();


--reset is reset
--operation mode is input

reset = INPUT();


--q is q
--operation mode is output

q = OUTPUT(rs[0]);


