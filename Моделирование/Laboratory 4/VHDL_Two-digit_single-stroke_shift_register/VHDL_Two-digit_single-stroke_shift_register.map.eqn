--s1 is s1
s1_or_out = D;
s1_reg_input = s1_or_out;
s1 = DFFE(s1_reg_input, GLOBAL(C), GLOBAL(R), , );


--s2 is s2
s2_or_out = s1;
s2_reg_input = s2_or_out;
s2 = DFFE(s2_reg_input, GLOBAL(C), GLOBAL(R), , );


--s3 is s3
s3_or_out = s2;
s3_reg_input = s3_or_out;
s3 = DFFE(s3_reg_input, !GLOBAL(C), GLOBAL(R), , );


--s4 is s4
s4_or_out = s3;
s4_reg_input = s4_or_out;
s4 = DFFE(s4_reg_input, !GLOBAL(C), GLOBAL(R), , );


--D is D
--operation mode is input

D = INPUT();


--C is C
--operation mode is input

C = INPUT();


--R is R
--operation mode is input

R = INPUT();


--D1 is D1
--operation mode is output

D1 = OUTPUT(s1);


--Q1 is Q1
--operation mode is output

Q1 = OUTPUT(s2);


--D2 is D2
--operation mode is output

D2 = OUTPUT(s3);


--Q2 is Q2
--operation mode is output

Q2 = OUTPUT(s4);


