--inst3 is inst3
inst3_reg_input = VCC;
inst3 = TFFE(inst3_reg_input, GLOBAL(c), GLOBAL(r), , jk);


--inst2 is inst2
inst2_or_out = jk;
inst2_reg_input = inst2_or_out;
inst2 = TFFE(inst2_reg_input, !inst3, GLOBAL(r), , );


--inst1 is inst1
inst1_or_out = jk;
inst1_reg_input = inst1_or_out;
inst1 = TFFE(inst1_reg_input, !inst2, GLOBAL(r), , );


--inst is inst
inst_or_out = jk;
inst_reg_input = inst_or_out;
inst = TFFE(inst_reg_input, !inst1, GLOBAL(r), , );


--r is r
--operation mode is input

r = INPUT();


--jk is jk
--operation mode is input

jk = INPUT();


--c is c
--operation mode is input

c = INPUT();


--q0 is q0
--operation mode is output

q0 = OUTPUT(inst3);


--q1 is q1
--operation mode is output

q1 = OUTPUT(inst2);


--q2 is q2
--operation mode is output

q2 = OUTPUT(inst1);


--q3 is q3
--operation mode is output

q3 = OUTPUT(inst);


