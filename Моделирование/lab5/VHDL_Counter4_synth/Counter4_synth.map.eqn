--cnt[0] is cnt[0]
--operation mode is normal

cnt[0]_lut_out = !cnt[0];
cnt[0] = DFFEAS(cnt[0]_lut_out, CLK, RST_N, , EN, , , , );


--cnt[1] is cnt[1]
--operation mode is normal

cnt[1]_lut_out = !cnt[1];
cnt[1] = DFFEAS(cnt[1]_lut_out, CLK, RST_N, , A1L5, , , , );


--cnt[2] is cnt[2]
--operation mode is normal

cnt[2]_lut_out = !cnt[2];
cnt[2] = DFFEAS(cnt[2]_lut_out, CLK, RST_N, , A1L7, , , , );


--cnt[3] is cnt[3]
--operation mode is normal

cnt[3]_lut_out = !cnt[3];
cnt[3] = DFFEAS(cnt[3]_lut_out, CLK, RST_N, , A1L9, , , , );


--A1L5 is cnt[1]~40
--operation mode is normal

A1L5 = cnt[0] & EN;


--A1L7 is cnt[2]~41
--operation mode is normal

A1L7 = cnt[0] & cnt[1] & EN;


--A1L9 is cnt[3]~42
--operation mode is normal

A1L9 = cnt[0] & cnt[1] & cnt[2] & EN;


--CLK is CLK
--operation mode is input

CLK = INPUT();


--RST_N is RST_N
--operation mode is input

RST_N = INPUT();


--EN is EN
--operation mode is input

EN = INPUT();


--Q[0] is Q[0]
--operation mode is output

Q[0] = OUTPUT(cnt[0]);


--Q[1] is Q[1]
--operation mode is output

Q[1] = OUTPUT(cnt[1]);


--Q[2] is Q[2]
--operation mode is output

Q[2] = OUTPUT(cnt[2]);


--Q[3] is Q[3]
--operation mode is output

Q[3] = OUTPUT(cnt[3]);


