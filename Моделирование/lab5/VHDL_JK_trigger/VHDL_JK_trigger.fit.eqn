--state is state at LC3
state_p1_out = state & !K;
state_p2_out = !state & J;
state_or_out = state_p1_out # state_p2_out;
state_reg_input = state_or_out;
state = DFFE(state_reg_input, GLOBAL(CLK), , , );


--A1L7 is state~21 at LC5
A1L7_or_out = !state;
A1L7 = A1L7_or_out;


--J is J at PIN_81
--operation mode is input

J = INPUT();


--K is K at PIN_33
--operation mode is input

K = INPUT();


--CLK is CLK at PIN_83
--operation mode is input

CLK = INPUT();


--Q is Q at PIN_12
--operation mode is output

Q = OUTPUT(state);


--Qn is Qn at PIN_11
--operation mode is output

Qn = OUTPUT(A1L7);






