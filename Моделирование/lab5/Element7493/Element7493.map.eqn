--B1_16 is 7493:inst|16
B1_16_reg_input = VCC;
B1_16 = TFFE(B1_16_reg_input, !GLOBAL(c), !r, , );


--B1_15 is 7493:inst|15
B1_15_reg_input = VCC;
B1_15 = TFFE(B1_15_reg_input, !B1_16, !r, , );


--B1_14 is 7493:inst|14
B1_14_or_out = B1_15;
B1_14_reg_input = B1_14_or_out;
B1_14 = TFFE(B1_14_reg_input, !B1_16, !r, , );


--B1_13 is 7493:inst|13
B1_13_p1_out = B1_15 & B1_14;
B1_13_or_out = B1_13_p1_out;
B1_13_reg_input = B1_13_or_out;
B1_13 = TFFE(B1_13_reg_input, !B1_16, !r, , );


--r is r
--operation mode is input

r = INPUT();


--c is c
--operation mode is input

c = INPUT();


--q0 is q0
--operation mode is output

q0 = OUTPUT(B1_16);


--q1 is q1
--operation mode is output

q1 = OUTPUT(B1_15);


--q2 is q2
--operation mode is output

q2 = OUTPUT(B1_14);


--q3 is q3
--operation mode is output

q3 = OUTPUT(B1_13);


