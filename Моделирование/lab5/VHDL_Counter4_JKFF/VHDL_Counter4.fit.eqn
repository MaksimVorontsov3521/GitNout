--s0 is s0 at LC_X52_Y30_N4
--operation mode is normal

s0_lut_out = !RST & (!s0);
s0 = DFFEAS(s0_lut_out, GLOBAL(CLK), VCC, , , , , , );


--s1 is s1 at LC_X52_Y30_N2
--operation mode is normal

s1_lut_out = !RST & (s1 $ s0);
s1 = DFFEAS(s1_lut_out, GLOBAL(CLK), VCC, , , , , , );


--s2 is s2 at LC_X52_Y30_N5
--operation mode is normal

s2_lut_out = !RST & (s2 $ (s1 & s0));
s2 = DFFEAS(s2_lut_out, GLOBAL(CLK), VCC, , , , , , );


--s3 is s3 at LC_X52_Y30_N8
--operation mode is normal

s3_lut_out = !RST & (s3 $ (A1L1 & s2));
s3 = DFFEAS(s3_lut_out, GLOBAL(CLK), VCC, , , , , , );


--A1L1 is add~111 at LC_X52_Y30_N6
--operation mode is normal

A1L1 = s1 & s0;


--RST is RST at PIN_D2
--operation mode is input

RST = INPUT();


--CLK is CLK at PIN_L2
--operation mode is input

CLK = INPUT();


--q0 is q0 at PIN_F4
--operation mode is output

q0 = OUTPUT(s0);


--q1 is q1 at PIN_B2
--operation mode is output

q1 = OUTPUT(s1);


--q2 is q2 at PIN_D1
--operation mode is output

q2 = OUTPUT(s2);


--q3 is q3 at PIN_G7
--operation mode is output

q3 = OUTPUT(s3);



