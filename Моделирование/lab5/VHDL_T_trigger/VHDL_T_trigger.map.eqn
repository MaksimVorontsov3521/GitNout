--state is state
state_reg_input = VCC;
state = TFFE(state_reg_input, GLOBAL(CLK), , , T);


--A1L5 is state~9
A1L5_or_out = !state;
A1L5 = A1L5_or_out;


--T is T
--operation mode is input

T = INPUT();


--CLK is CLK
--operation mode is input

CLK = INPUT();


--Q is Q
--operation mode is output

Q = OUTPUT(state);


--Qn is Qn
--operation mode is output

Qn = OUTPUT(A1L5);


