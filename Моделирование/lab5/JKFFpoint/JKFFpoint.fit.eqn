--inst is inst at LC3
inst_p1_out = inst & !K;
inst_p2_out = !inst & J;
inst_or_out = inst_p1_out # inst_p2_out;
inst_reg_input = inst_or_out;
inst = DFFE(inst_reg_input, GLOBAL(c), GLOBAL(CLRN), PRN, );


--PRN is PRN at PIN_81
--operation mode is input

PRN = INPUT();


--CLRN is CLRN at PIN_1
--operation mode is input

CLRN = INPUT();


--K is K at PIN_33
--operation mode is input

K = INPUT();


--J is J at PIN_4
--operation mode is input

J = INPUT();


--c is c at PIN_83
--operation mode is input

c = INPUT();


--Q is Q at PIN_12
--operation mode is output

Q = OUTPUT(inst);






