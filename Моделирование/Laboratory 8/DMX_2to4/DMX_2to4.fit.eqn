--inst is inst at LC_X7_Y1_N6
--operation mode is normal

inst = !X0 & E & !X1;


--inst5 is inst5 at LC_X7_Y1_N4
--operation mode is normal

inst5 = X0 & E & !X1;


--inst7 is inst7 at LC_X7_Y1_N5
--operation mode is normal

inst7 = !X0 & E & X1;


--inst6 is inst6 at LC_X7_Y1_N2
--operation mode is normal

inst6 = X0 & E & X1;


--E is E at PIN_V18
--operation mode is input

E = INPUT();


--X0 is X0 at PIN_V17
--operation mode is input

X0 = INPUT();


--X1 is X1 at PIN_Y16
--operation mode is input

X1 = INPUT();


--F0 is F0 at PIN_U16
--operation mode is output

F0 = OUTPUT(inst);


--F1 is F1 at PIN_T16
--operation mode is output

F1 = OUTPUT(inst5);


--F2 is F2 at PIN_V16
--operation mode is output

F2 = OUTPUT(inst7);


--F3 is F3 at PIN_U17
--operation mode is output

F3 = OUTPUT(inst6);



