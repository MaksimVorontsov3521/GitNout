--B1L1 is multiplexer_4-1:inst|inst~14
--operation mode is normal

B1L1 = B $ Cin $ A;


--B2L1 is multiplexer_4-1:inst4|inst~66
--operation mode is normal

B2L1 = B & (Cin # A) # !B & Cin & A;


--B is B
--operation mode is input

B = INPUT();


--Cin is Cin
--operation mode is input

Cin = INPUT();


--A is A
--operation mode is input

A = INPUT();


--Sum is Sum
--operation mode is output

Sum = OUTPUT(B1L1);


--Count is Count
--operation mode is output

Count = OUTPUT(B2L1);


