--B1L1 is multiplexer_4-1:inst|inst~14 at LC_X1_Y30_N0
--operation mode is normal

B1L1 = Cin $ B $ A;


--B2L1 is multiplexer_4-1:inst4|inst~66 at LC_X1_Y30_N4
--operation mode is normal

B2L1 = Cin & (B # A) # !Cin & B & A;


--B is B at PIN_B21
--operation mode is input

B = INPUT();


--Cin is Cin at PIN_M16
--operation mode is input

Cin = INPUT();


--A is A at PIN_C20
--operation mode is input

A = INPUT();


--Sum is Sum at PIN_D22
--operation mode is output

Sum = OUTPUT(B1L1);


--Count is Count at PIN_D20
--operation mode is output

Count = OUTPUT(B2L1);



