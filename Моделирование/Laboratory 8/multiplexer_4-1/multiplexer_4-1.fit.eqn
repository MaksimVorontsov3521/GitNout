--A1L9 is inst~169 at LC_X52_Y1_N2
--operation mode is normal

A1L9 = B & D3 # !B & (D1);


--A1L01 is inst~170 at LC_X52_Y1_N5
--operation mode is normal

A1L01 = B & D2 # !B & (D0);


--A1L11 is inst~171 at LC_X52_Y1_N4
--operation mode is normal

A1L11 = E & (A & A1L9 # !A & (A1L01));


--E is E at PIN_W4
--operation mode is input

E = INPUT();


--D3 is D3 at PIN_AA2
--operation mode is input

D3 = INPUT();


--D1 is D1 at PIN_AA3
--operation mode is input

D1 = INPUT();


--B is B at PIN_Y3
--operation mode is input

B = INPUT();


--D2 is D2 at PIN_T7
--operation mode is input

D2 = INPUT();


--D0 is D0 at PIN_W3
--operation mode is input

D0 = INPUT();


--A is A at PIN_V3
--operation mode is input

A = INPUT();


--F is F at PIN_V4
--operation mode is output

F = OUTPUT(A1L11);



