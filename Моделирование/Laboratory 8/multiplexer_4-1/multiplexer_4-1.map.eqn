--A1L9 is inst~169
--operation mode is normal

A1L9 = B & D3 # !B & (D1);


--A1L01 is inst~170
--operation mode is normal

A1L01 = B & D2 # !B & (D0);


--A1L11 is inst~171
--operation mode is normal

A1L11 = E & (A & A1L9 # !A & (A1L01));


--E is E
--operation mode is input

E = INPUT();


--D3 is D3
--operation mode is input

D3 = INPUT();


--D1 is D1
--operation mode is input

D1 = INPUT();


--B is B
--operation mode is input

B = INPUT();


--D2 is D2
--operation mode is input

D2 = INPUT();


--D0 is D0
--operation mode is input

D0 = INPUT();


--A is A
--operation mode is input

A = INPUT();


--F is F
--operation mode is output

F = OUTPUT(A1L11);


