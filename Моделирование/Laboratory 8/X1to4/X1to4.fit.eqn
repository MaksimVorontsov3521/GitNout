--B1L1 is multiplexer_4-1:inst|inst~3 at LC_X36_Y30_N2
--operation mode is normal

B1L1 = x3 & (x4 # x1 & !x2) # !x3 & x1 & !x2;


--x4 is x4 at PIN_E9
--operation mode is input

x4 = INPUT();


--x3 is x3 at PIN_F9
--operation mode is input

x3 = INPUT();


--x1 is x1 at PIN_C9
--operation mode is input

x1 = INPUT();


--x2 is x2 at PIN_D9
--operation mode is input

x2 = INPUT();


--F is F at PIN_L7
--operation mode is output

F = OUTPUT(B1L1);



