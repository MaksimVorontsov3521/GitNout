--B1L1 is multiplexer_4-1:inst|inst~1
--operation mode is normal

B1L1 = Y1 $ Y0;


--Y1 is Y1
--operation mode is input

Y1 = INPUT();


--Y0 is Y0
--operation mode is input

Y0 = INPUT();


--F1 is F1
--operation mode is output

F1 = OUTPUT(!B1L1);


