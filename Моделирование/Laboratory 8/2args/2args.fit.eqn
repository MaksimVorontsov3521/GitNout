--B1L1 is multiplexer_4-1:inst3|inst~1 at LC_X52_Y1_N2
--operation mode is normal

B1L1 = a0 $ a1;


--a1 is a1 at PIN_V4
--operation mode is input

a1 = INPUT();


--a0 is a0 at PIN_W4
--operation mode is input

a0 = INPUT();


--F is F at PIN_W3
--operation mode is output

F = OUTPUT(B1L1);



