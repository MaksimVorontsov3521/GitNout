--A1L01 is F~40
--operation mode is normal

A1L01 = a[1] # a[0] # !E;


--A1L11 is F~41
--operation mode is normal

A1L11 = E & a[0] & (!a[1]);


--A1L21 is F~42
--operation mode is normal

A1L21 = a[1] & E & (!a[0]);


--A1L31 is F~43
--operation mode is normal

A1L31 = a[1] & E & a[0];


--a[1] is a[1]
--operation mode is input

a[1] = INPUT();


--a[0] is a[0]
--operation mode is input

a[0] = INPUT();


--E is E
--operation mode is input

E = INPUT();


--F[0] is F[0]
--operation mode is output

F[0] = OUTPUT(!A1L01);


--F[1] is F[1]
--operation mode is output

F[1] = OUTPUT(A1L11);


--F[2] is F[2]
--operation mode is output

F[2] = OUTPUT(A1L21);


--F[3] is F[3]
--operation mode is output

F[3] = OUTPUT(A1L31);


