--B1_inst is multiplexer_4-1:inst|inst at LC_X1_Y1_N2
--operation mode is normal

B1_inst = Y2 & Y1 & Y3 # !Y2 & !Y1;


--Y3 is Y3 at PIN_W19
--operation mode is input

Y3 = INPUT();


--Y1 is Y1 at PIN_Y20
--operation mode is input

Y1 = INPUT();


--Y2 is Y2 at PIN_AA20
--operation mode is input

Y2 = INPUT();


--F is F at PIN_W20
--operation mode is output

F = OUTPUT(B1_inst);



