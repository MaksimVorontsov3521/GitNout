--C1_q is d_behav:inst3|q at LC11
C1_q_or_out = D-input;
C1_q_reg_input = C1_q_or_out;
C1_q = DFFE(C1_q_reg_input, GLOBAL(C-input), , , );


--E1L2 is D-trigger:inst2|RS-trigger:inst1|inst~30 at LC8
E1L2_p1_out = !E1L2 & !C-input;
E1L2_p2_out = !E1L2 & !D-input;
E1L2_p4_out = C-input & !D-input;
E1L2_or_out = E1L2_p1_out # E1L2_p2_out # GND # E1L2_p4_out;
E1L2 = !(E1L2_or_out);


--F1L1 is dstr:inst4|notand:u1|c~8 at LC6
F1L1_p1_out = F1L1 & !C-input;
F1L1_p2_out = C-input & D-input;
F1L1_p3_out = F1L1 & D-input;
F1L1_or_out = F1L1_p1_out # F1L1_p2_out # F1L1_p3_out;
F1L1 = F1L1_or_out;


--E1L1 is D-trigger:inst2|RS-trigger:inst1|inst3~2 at LC5
E1L1_p1_out = E1L2 & B1L1;
E1L1_or_out = E1L1_p1_out;
E1L1 = !(E1L1_or_out);


--F2L1 is dstr:inst4|notand:u2|c~27 at LC3
F2L1_p1_out = F1L1 & B1L1;
F2L1_or_out = F2L1_p1_out;
F2L1 = !(F2L1_or_out);


--B1L1 is D-trigger:inst2|inst3~3sexp at SEXP3
B1L1 = EXP(C-input & !D-input);


--D-input is D-input at PIN_81
--operation mode is input

D-input = INPUT();


--C-input is C-input at PIN_83
--operation mode is input

C-input = INPUT();


--d_behav_q is d_behav_q at PIN_8
--operation mode is output

d_behav_q = OUTPUT(C1_q);


--D-trigger-Q is D-trigger-Q at PIN_9
--operation mode is output

D-trigger-Q = OUTPUT(E1L2);


--dstr_q is dstr_q at PIN_10
--operation mode is output

dstr_q = OUTPUT(F1L1);


--D-trigger_QB is D-trigger_QB at PIN_11
--operation mode is output

D-trigger_QB = OUTPUT(E1L1);


--dstr_qb is dstr_qb at PIN_12
--operation mode is output

dstr_qb = OUTPUT(F2L1);






